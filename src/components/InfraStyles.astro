---
/**
 * 基础设施页（根路由 / 切换页 / 404）共享的极简中性样式。
 * 使用 is:inline 保持在 HTML 内联：保证根路由页零外部请求（SPEC §7.3），
 * 且不引入任何 Tailwind 依赖（共享组件零工具类约定，SPEC §8.4）。
 */
---
<style is:inline>
  :root {
    color-scheme: light dark;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    background: #fafafa;
    color: #171717;
    line-height: 1.65;
  }
  @media (prefers-color-scheme: dark) {
    body {
      background: #0f1012;
      color: #e9e9ec;
    }
  }
  .infra {
    width: min(42rem, calc(100% - 3rem));
    padding: 2rem 0 4rem;
  }
  .infra h1 {
    font-size: 1.35rem;
    margin: 0 0 0.25rem;
  }
  .infra p {
    margin: 0.4rem 0 0;
    opacity: 0.75;
  }
  .infra-redirect {
    text-align: center;
    opacity: 0.6;
  }
  .infra-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .infra-card {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
  }
  .infra-card:hover {
    border-color: currentColor;
  }
  .infra-card .name {
    display: block;
    font-weight: 600;
  }
  .infra-card .desc {
    display: block;
    font-size: 0.875rem;
    opacity: 0.7;
  }
  .infra-card[data-current='true'] {
    border-color: currentColor;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  /* 「当前」标记是切换页模板里的真实元素（可本地化、可被读屏读取），
     不是 CSS content 生成的伪元素——后者无法随语言切换（SPEC §4）。 */
  .lang-badge {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.65;
  }
  .lang-badge[hidden] {
    display: none;
  }
  .chip {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    border-radius: 999px;
    background: var(--chip, currentColor);
    margin-right: 0.5em;
  }
  /* 基础设施页上的语言切换器（项目 chrome，中性外观） */
  .lang-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
  }
  .lang-switch-label {
    opacity: 0.6;
  }
  .lang-switch-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }
  .lang-switch-link {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .lang-switch-link[aria-current='page'] {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid currentColor;
  }
</style>