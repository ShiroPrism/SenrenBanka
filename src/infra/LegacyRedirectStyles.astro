---
/**
 * 旧路径跳转页专用最小样式：只保留 `LegacyRedirect` 实际渲染用到的规则。
 * 基础规则与 `InfraStyles.astro` 保持一致，改动那里时同步这里。
 */
---

<style is:inline>
  :root {
    color-scheme: light dark;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'PingFang SC',
      'Hiragino Sans GB',
      'Microsoft YaHei',
      sans-serif;
    background: #fafafa;
    color: #171717;
    line-height: 1.65;
  }
  @media (prefers-color-scheme: dark) {
    body {
      background: #0f1012;
      color: #e9e9ec;
    }
  }
  .infra {
    width: min(74rem, calc(100% - 3rem));
    padding: 2rem 0 4rem;
  }
  .infra p {
    margin: 0.4rem 0 0;
    opacity: 0.75;
  }
  .infra-redirect {
    text-align: center;
    opacity: 0.6;
  }
  .infra-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.75rem;
    border: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    background: color-mix(in oklab, Canvas 92%, currentColor 8%);
  }
  .infra-card:hover {
    border-color: currentColor;
  }
</style>
