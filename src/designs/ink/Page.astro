---
/**
 * ink — 宋式册页 / 侘寂。
 *
 * 数据：`loadDesignView('ink', Astro.url.pathname)` 只取当前语言（同一数据源与构建期校验；
 * 页面不接触文件路径、不自行判断语言）。
 *
 * 版式：一张居中的册页。桌面（≥1024px）右缘是一列竖排题署（引首标签 / 姓名 / 题 / 印），
 * 左侧横排小引与印谱；1024px 以下竖排关闭，全部改为横排单列。
 * 动效：纯 CSS 一次性墨色渗入 + 朱砂印落下 + 细线展开；滚动显现由共享 Reveal 触发。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import { messages as designMessages } from './messages';
import './style.css';

const view = await loadDesignView('ink', Astro.url.pathname);
const t = designMessages[view.locale.code];
const { profile, contextMenu } = view;

/* 印章只钤姓名首字；按字素切分，避免拆开代理对。 */
const sealGlyph = Array.from(profile.name)[0] ?? '';

/* 可选区块先归一到数组，模板内不需要再判空。 */
const projects = profile.projects ?? [];
const experience = profile.experience ?? [];
const skills = profile.skills ?? [];
const contact = profile.contact;

const hasProjects = projects.length > 0;
const hasExperience = experience.length > 0;
const hasSkills = skills.length > 0;
const contactEmail = contact?.email ?? '';
const contactNote = contact?.note ?? '';
const location = profile.location ?? '';
const hasContact = Boolean(contactEmail || contactNote);

/* 引首编号随实际渲染的分区连续递增（缺区块时不留空号）。装饰性，aria-hidden。 */
let mark = 0;
const marks = {
  projects: hasProjects ? mark++ : -1,
  experience: hasExperience ? mark++ : -1,
  skills: hasSkills ? mark++ : -1,
  contact: hasContact ? mark++ : -1,
};
const numeral = (index: number) => t.numerals[index] ?? String(index + 1);
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    <Font cssVariable="--font-sorts-mill-goudy" />
    <Font cssVariable="--font-prociono" />
    <Font cssVariable="--font-lxgw" />
    <Font cssVariable="--font-zhuque" />
    <Reveal />
  </head>
  <body class="ink">
    <div class="ink-leaf">
      <header class="ink-masthead">
        <span>{t.portfolio}</span>
        <span class="ink-masthead-meta">
          {location && <span>{location}</span>}
          <span class="ink-masthead-dot" aria-hidden="true"></span>
          <span>{t.leaf}</span>
        </span>
      </header>

      <main>
        <section class="ink-hero" aria-labelledby="ink-name">
          <div class="ink-tiers">
            <p class="ink-kicker ink-rise" style="--ink-delay: 0ms">{t.portfolio}</p>
            <h1 id="ink-name" class="ink-name ink-rise" style="--ink-delay: 90ms">
              {profile.name}
            </h1>
            <p class="ink-headline ink-rise" style="--ink-delay: 180ms">{profile.headline}</p>
            <span class="ink-seal" aria-hidden="true">{sealGlyph}</span>
          </div>

          <div class="ink-prose">
            <div class="ink-block">
              <p class="ink-label">{t.preface}</p>
              <p class="ink-bio">{profile.bio}</p>
            </div>

            {
              profile.links.length > 0 && (
                <div class="ink-block">
                  <p class="ink-label">{t.imprint}</p>
                  <ul class="ink-slips">
                    {profile.links.map((link) => (
                      <li>
                        <a class="ink-slip-link" href={link.url}>
                          <span class="ink-slip-mark" aria-hidden="true" />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>
        </section>

        {
          hasProjects && (
            <section class="ink-section" aria-labelledby="ink-projects-title" data-reveal>
              <p class="ink-gutter" aria-hidden="true">{numeral(marks.projects)}</p>
              <div class="ink-section-body">
                <div class="ink-section-head">
                  <h2 id="ink-projects-title" class="ink-section-title">{t.projects}</h2>
                  <span class="ink-rule-line" aria-hidden="true" />
                </div>
                <ul class="ink-volumes">
                  {projects.map((project) => (
                    <li class="ink-volume" data-reveal>
                      <h3 class="ink-volume-title">
                        {project.url ? <a href={project.url}>{project.title}</a> : project.title}
                      </h3>
                      {project.description && (
                        <p class="ink-volume-desc">{project.description}</p>
                      )}
                      {project.tags && project.tags.length > 0 && (
                        <p class="ink-volume-tags">{project.tags.join(' · ')}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }

        {
          hasExperience && (
            <section class="ink-section" aria-labelledby="ink-experience-title" data-reveal>
              <p class="ink-gutter" aria-hidden="true">{numeral(marks.experience)}</p>
              <div class="ink-section-body">
                <div class="ink-section-head">
                  <h2 id="ink-experience-title" class="ink-section-title">{t.experience}</h2>
                  <span class="ink-rule-line" aria-hidden="true" />
                </div>
                <ol class="ink-chronology">
                  {experience.map((item) => (
                    <li class="ink-chrono-row" data-reveal>
                      <div class="ink-chrono-main">
                        <span class="ink-chrono-org">{item.org}</span>
                        {item.role && <span class="ink-chrono-role">{item.role}</span>}
                      </div>
                      {item.period && <span class="ink-chrono-period">{item.period}</span>}
                      {item.description && (
                        <p class="ink-chrono-desc">{item.description}</p>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          )
        }

        {
          hasSkills && (
            <section class="ink-section" aria-labelledby="ink-skills-title" data-reveal>
              <p class="ink-gutter" aria-hidden="true">{numeral(marks.skills)}</p>
              <div class="ink-section-body">
                <div class="ink-section-head">
                  <h2 id="ink-skills-title" class="ink-section-title">{t.skills}</h2>
                  <span class="ink-rule-line" aria-hidden="true" />
                </div>
                <ul class="ink-brushwork">
                  {skills.map((skill) => (
                    <li class="ink-stroke">{skill}</li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }

        {
          hasContact && (
            <section class="ink-section" aria-labelledby="ink-contact-title" data-reveal>
              <p class="ink-gutter" aria-hidden="true">{numeral(marks.contact)}</p>
              <div class="ink-section-body">
                <div class="ink-section-head">
                  <h2 id="ink-contact-title" class="ink-section-title">{t.contact}</h2>
                  <span class="ink-rule-line" aria-hidden="true" />
                </div>
                <div class="ink-colophon">
                  {contactEmail && (
                    <a class="ink-colophon-mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
                  )}
                  {contactNote && <p class="ink-colophon-note">{contactNote}</p>}
                </div>
              </div>
            </section>
          )
        }
      </main>

      <footer class="ink-footer">
        <span>{profile.name}</span>
        <span>{t.footerNote}</span>
      </footer>
    </div>
    <ContextMenu config={contextMenu} />
  </body>
</html>
