---
/** frost 预览碎片：极光、双层毛玻璃、胶囊控件与 iOS 蓝。 */
import { messages } from './messages';
import type { PreviewProps } from '../preview';
import './tokens.css';

export const fonts: import('astro:assets').CssVariable[] = ['--font-inter'];

const { locale, name, headline, location } = Astro.props as PreviewProps;
const t = messages[locale];
---

<div class="fr-pv">
  <div class="fr-pv-aurora"></div>
  <div class="fr-pv-nav">
    <span>{name}</span>
    <span>{location ?? 'SENRENBANKA'}</span>
  </div>
  <div class="fr-pv-body">
    <p class="fr-pv-name">{name}</p>
    <p class="fr-pv-headline">{headline}</p>
    <div class="fr-pv-actions">
      <span class="fr-pv-pill">{t.projects}</span>
      <span class="fr-pv-pill fr-pv-pill-accent">{t.contact}</span>
    </div>
    <div class="fr-pv-card">
      <p>{t.experience}</p>
      <span>{t.skills}</span>
    </div>
  </div>
</div>

<style>
  .fr-pv {
    position: relative;
    min-height: 9rem;
    overflow: hidden;
    background: var(--fr-canvas);
    color: var(--fr-label);
    font-family: var(--font-inter), var(--font-gothic-a1), system-ui, "PingFang SC", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    font-size: 0.55rem;
    line-height: 1.4;
    color-scheme: light dark;
  }

  .fr-pv-aurora {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 70% at 10% 5%, rgba(122, 184, 255, 0.58), transparent 70%),
      radial-gradient(70% 70% at 85% 12%, rgba(196, 165, 255, 0.5), transparent 70%),
      radial-gradient(75% 75% at 70% 95%, rgba(123, 224, 214, 0.48), transparent 72%);
  }

  @media (prefers-color-scheme: dark) {
    .fr-pv-aurora {
      background:
        radial-gradient(80% 70% at 10% 5%, rgba(36, 106, 199, 0.6), transparent 70%),
        radial-gradient(70% 70% at 85% 12%, rgba(104, 76, 190, 0.55), transparent 70%),
        radial-gradient(75% 75% at 70% 95%, rgba(22, 122, 114, 0.5), transparent 72%);
    }
  }

  .fr-pv-nav {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.45rem 0.65rem;
    background: var(--fr-nav-bg);
    border-bottom: 1px solid var(--fr-nav-border);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    font-weight: 600;
  }

  .fr-pv-nav span:last-child {
    color: var(--fr-secondary);
    font-weight: 400;
  }

  .fr-pv-body {
    position: relative;
    padding: 0.6rem 0.7rem 0.75rem;
  }

  .fr-pv-name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .fr-pv-headline {
    display: -webkit-box;
    margin: 0.18rem 0 0.45rem;
    overflow: hidden;
    color: var(--fr-secondary);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .fr-pv-actions {
    display: flex;
    gap: 0.3rem;
  }

  .fr-pv-pill {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--fr-fill);
    font-size: 0.48rem;
  }

  .fr-pv-pill-accent {
    background: var(--fr-accent-solid);
    color: #fff;
  }

  .fr-pv-card {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.45rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--fr-hairline);
    border-radius: 0.65rem;
    background: var(--fr-card-bg);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
  }

  .fr-pv-card p {
    margin: 0;
  }

  .fr-pv-card span {
    color: var(--fr-secondary);
  }
</style>
