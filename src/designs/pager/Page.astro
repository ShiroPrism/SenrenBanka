---
/**
 * pager — 一台别在腰上的寻呼机（Motorola Advisor 气质）。
 *
 * 整页 = 这台机器：机壳 + 扬声器槽 + 单色 LCD（状态栏 / 收件箱 / 屏显收尾）+ 按键行与滚轮。
 * 屏里每一条消息 = 一个分区（可见 h2 + 编号），编号在 DOM 顺序上连续递增（装饰，aria-hidden）。
 *
 * 数据：`loadDesignView` 只取当前语言视图（本套不做多语言同屏），语言由路径统一解析。
 * 动效：整屏「开机两段亮度跳变」+ 消息逐条 2 步载入；滚动显现复用共享 IntersectionObserver
 * （门控 `html[data-reveal-ready]`，契约见 docs/rules/visual-language.md；参数见 DESIGN.md「Motion」）。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import { messages as designMessages, type PagerMessages } from './messages';
import './style.css';

const view = await loadDesignView('pager', Astro.url.pathname);
const t: PagerMessages = designMessages[view.locale.code];
const { profile, contextMenu } = view;

const pad = (n: number) => String(n).padStart(2, '0');
/** 状态栏 MSG 数 = 链接条数（真实数据，不是装饰数字）。 */
const count = pad(profile.links.length);
const shortUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/^mailto:/, '');

// 消息编号：按渲染顺序连续，缺区块（projects / experience / skills）时不出现空号。
const hasProjects = Boolean(profile.projects && profile.projects.length > 0);
const hasExperience = Boolean(profile.experience && profile.experience.length > 0);
const hasSkills = Boolean(profile.skills && profile.skills.length > 0);
const no = (() => {
  let n = 0;
  const next = () => pad(++n);
  return {
    bio: next(),
    links: next(),
    projects: hasProjects ? next() : '',
    experience: hasExperience ? next() : '',
    skills: hasSkills ? next() : '',
    contact: next(),
  };
})();

// 段内载入节奏：一条消息 = 头行先亮、正文行随后（每行一次 2 步跳变）；
// 超过 8 行的部分回落为满延迟，避免尾部等待。
const STEP = 70;
const d = (n: number) => `${Math.min(n, 8) * STEP}ms`;
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {/* 不预加载：像素小字 + 点阵数字 + 中文像素各一；swap + 系统回退已足够（开机闪一下是主题的一部分） */}
    <Font cssVariable="--font-silkscreen" />
    <Font cssVariable="--font-handjet" />
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-ark-pixel" />}
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-galmuri11" />}
    <Reveal />

    {view.locale.code === 'zh-TW' && (
      <>
        <Font cssVariable="--font-fusion-pixel-tc" />
      </>
    )}
  </head>
  <body class="pg">
    <main class="pg-device" aria-label={t.pageLabel}>
      <div class="pg-top">
        <span class="pg-grille" aria-hidden="true"></span>
        <p class="pg-brand">{t.brand}</p>
        <span class="pg-led" aria-hidden="true"></span>
      </div>

      <div class="pg-screen">
        <div class="pg-status" aria-hidden="true">
          <span class="pg-signal">
            <span class="pg-bar"></span>
            <span class="pg-bar"></span>
            <span class="pg-bar"></span>
            <span class="pg-bar"></span>
          </span>
          <span class="pg-batt"></span>
          <span class="pg-count">
            {t.msgLabel} <span class="pg-digit">{count}</span>
          </span>
        </div>

        <header class="pg-head">
          <h1 class="pg-name pg-line" style={`--d:${d(2)}`}>
            {profile.name}
          </h1>
          <p class="pg-headline pg-line" style={`--d:${d(3)}`}>
            {profile.headline}
          </p>
          {profile.location && (
            <p class="pg-loc pg-line" style={`--d:${d(4)}`}>
              <span class="pg-k">{t.locLabel}</span> {profile.location}
            </p>
          )}
        </header>

        <section class="pg-msg" aria-labelledby="pg-memo-title">
          <div class="pg-msg-head pg-line" style={`--d:${d(5)}`}>
            <span class="pg-msg-no" aria-hidden="true">
              {no.bio}
            </span>
            <h2 class="pg-msg-title" id="pg-memo-title">
              {t.memoTitle}
            </h2>
            <span class="pg-msg-rule" aria-hidden="true"></span>
          </div>
          <p class="pg-body pg-line" style={`--d:${d(6)}`}>
            {profile.bio}
          </p>
        </section>

        <section class="pg-msg" data-reveal aria-labelledby="pg-links-title">
          <div class="pg-msg-head pg-line" style={`--d:${d(0)}`}>
            <span class="pg-msg-no" aria-hidden="true">
              {no.links}
            </span>
            <h2 class="pg-msg-title" id="pg-links-title">
              {t.linksTitle}
            </h2>
            <span class="pg-msg-rule" aria-hidden="true"></span>
          </div>
          <ul class="pg-links">
            {profile.links.map((link, index) => (
              <li class="pg-line" style={`--d:${d(index + 1)}`}>
                <a class="pg-link" href={link.url}>
                  {link.label}
                </a>{' '}
                <span class="pg-url" aria-hidden="true">
                  {shortUrl(link.url)}
                </span>
              </li>
            ))}
          </ul>
        </section>

        {hasProjects && (
          <section class="pg-msg" data-reveal aria-labelledby="pg-projects-title">
            <div class="pg-msg-head pg-line" style={`--d:${d(0)}`}>
              <span class="pg-msg-no" aria-hidden="true">
                {no.projects}
              </span>
              <h2 class="pg-msg-title" id="pg-projects-title">
                {t.projectsTitle}
              </h2>
              <span class="pg-msg-rule" aria-hidden="true"></span>
            </div>
            <ul class="pg-projects">
              {profile.projects?.map((project, index) => (
                <li class="pg-line" style={`--d:${d(index * 2 + 1)}`}>
                  <p class="pg-row-head">
                    {project.url ? (
                      <a class="pg-link" href={project.url}>
                        {project.title}
                      </a>
                    ) : (
                      <span>{project.title}</span>
                    )}
                  </p>
                  {project.url && (
                    <p class="pg-meta" aria-hidden="true">
                      {shortUrl(project.url)}
                    </p>
                  )}
                  {project.description && <p class="pg-note">{project.description}</p>}
                  {project.tags && project.tags.length > 0 && (
                    <p class="pg-tags">{project.tags.join(' · ')}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {hasExperience && (
          <section class="pg-msg" data-reveal aria-labelledby="pg-history-title">
            <div class="pg-msg-head pg-line" style={`--d:${d(0)}`}>
              <span class="pg-msg-no" aria-hidden="true">
                {no.experience}
              </span>
              <h2 class="pg-msg-title" id="pg-history-title">
                {t.experienceTitle}
              </h2>
              <span class="pg-msg-rule" aria-hidden="true"></span>
            </div>
            <ul class="pg-history">
              {profile.experience?.map((item, index) => (
                <li class="pg-line" style={`--d:${d(index * 2 + 1)}`}>
                  <p class="pg-row-head">
                    <span class="pg-period">{item.period ?? '----'}</span> <span>{item.org}</span>
                    {item.role ? <span class="pg-dim"> — {item.role}</span> : null}
                  </p>
                  {item.description && <p class="pg-note">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {hasSkills && (
          <section class="pg-msg" data-reveal aria-labelledby="pg-skills-title">
            <div class="pg-msg-head pg-line" style={`--d:${d(0)}`}>
              <span class="pg-msg-no" aria-hidden="true">
                {no.skills}
              </span>
              <h2 class="pg-msg-title" id="pg-skills-title">
                {t.skillsTitle}
              </h2>
              <span class="pg-msg-rule" aria-hidden="true"></span>
            </div>
            <p class="pg-body pg-line" style={`--d:${d(1)}`}>
              {profile.skills?.join(' ・ ')}
            </p>
          </section>
        )}

        <section class="pg-msg" data-reveal aria-labelledby="pg-contact-title">
          <div class="pg-msg-head pg-line" style={`--d:${d(0)}`}>
            <span class="pg-msg-no" aria-hidden="true">
              {no.contact}
            </span>
            <h2 class="pg-msg-title" id="pg-contact-title">
              {t.contactTitle}
            </h2>
            <span class="pg-msg-rule" aria-hidden="true"></span>
          </div>
          {profile.contact?.email ? (
            <p class="pg-mail pg-line" style={`--d:${d(1)}`}>
              <span class="pg-k">{t.replyTo}</span>{' '}
              <a class="pg-link" href={`mailto:${profile.contact.email}`}>
                {profile.contact.email}
              </a>
            </p>
          ) : (
            <p class="pg-note pg-line" style={`--d:${d(1)}`}>
              {t.noMail}
            </p>
          )}
          {profile.contact?.note && (
            <p class="pg-note pg-line" style={`--d:${d(2)}`}>
              {profile.contact.note}
            </p>
          )}
          <p class="pg-total pg-line" style={`--d:${d(3)}`}>
            <span class="pg-total-label">{t.totalLabel}</span>
            <span class="pg-total-num">{count}</span>
            <span class="pg-dim">{t.totalUnit}</span>
          </p>
        </section>

        <footer class="pg-end" data-reveal aria-label={t.endLabel}>
          <p class="pg-end-line pg-line" style={`--d:${d(0)}`}>
            {t.endLine}
          </p>
          {view.locale.notice && (
            <p class="pg-end-note pg-line" style={`--d:${d(1)}`}>
              {view.locale.notice}
            </p>
          )}
        </footer>
      </div>

      <div class="pg-keys" aria-hidden="true">
        <span class="pg-key">
          <span class="pg-key-arrow pg-key-prev"></span>
        </span>
        <span class="pg-key">
          <span class="pg-key-arrow pg-key-next"></span>
        </span>
        <span class="pg-wheel"></span>
      </div>
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
