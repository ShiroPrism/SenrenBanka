---
/** pager 预览碎片：塑料机身、LCD、信号/电池/MSG 与消息行。 */
import { messages } from './messages';
import type { PreviewProps } from '../preview';
import './tokens.css';

export const fonts: import('astro:assets').CssVariable[] = [
  '--font-silkscreen',
  '--font-handjet',
  '--font-ark-pixel',
];

const { locale, name, headline, location, links = [] } = Astro.props as PreviewProps;
const t = messages[locale as 'zh-CN' | 'ja' | 'en'];
const count = String(links.length).padStart(2, '0');
---

<div class="pg-pv">
  <div class="pg-pv-device">
    <div class="pg-pv-top">
      <span class="pg-pv-grille"></span>
      <span class="pg-pv-brand">{t.brand}</span>
      <span class="pg-pv-led"></span>
    </div>
    <div class="pg-pv-screen">
      <div class="pg-pv-status">
        <span class="pg-pv-signal"><i></i><i></i><i></i><i></i></span>
        <span class="pg-pv-batt"></span>
        <span>{t.msgLabel} <b>{count}</b></span>
      </div>
      <p class="pg-pv-name">{name}</p>
      <p class="pg-pv-headline">{headline}</p>
      {location && <p class="pg-pv-loc">{t.locLabel} {location}</p>}
      <p class="pg-pv-msg"><span>01</span>{t.memoTitle}<i></i></p>
      <p class="pg-pv-msg"><span>02</span>{t.linksTitle}<i></i></p>
      <p class="pg-pv-end">{t.endLine}</p>
    </div>
  </div>
</div>

<style>
  .pg-pv {
    display: grid;
    place-items: center;
    min-height: 9rem;
    padding: 0.7rem 1rem;
    overflow: hidden;
    background: radial-gradient(120% 80% at 50% -10%, var(--pg-back-rise), var(--pg-back) 58%);
    color: var(--pg-ink);
    font-family: var(--font-silkscreen), var(--font-ark-pixel), "Songti SC", monospace;
    font-size: 0.55rem;
    line-height: 1.5;
  }

  .pg-pv-device {
    width: min(17rem, 100%);
    padding: 0.55rem;
    border-radius: 0.8rem;
    background: linear-gradient(180deg, var(--pg-shell), var(--pg-shell-2) 74%);
    box-shadow: 0 9px 18px rgba(0, 0, 0, 0.48), inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .pg-pv-top {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.15rem 0.38rem;
  }

  .pg-pv-grille {
    width: 2.5rem;
    height: 0.42rem;
    background: repeating-linear-gradient(180deg, var(--pg-shell-hi) 0 1px, transparent 1px 3px);
  }

  .pg-pv-brand {
    flex: 1;
    color: var(--pg-lcd);
    font-size: 0.42rem;
    letter-spacing: 0.16em;
  }

  .pg-pv-led {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--pg-green);
    box-shadow: var(--pg-glow-led);
  }

  .pg-pv-screen {
    padding: 0.45rem 0.55rem 0.55rem;
    border-radius: 0.25rem;
    background: var(--pg-lcd);
    box-shadow: var(--pg-shadow-screen);
  }

  .pg-pv-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.18rem 0.28rem;
    background: var(--pg-lcd-2);
    font-size: 0.4rem;
    letter-spacing: 0.08em;
  }

  .pg-pv-status > span:last-child {
    margin-left: auto;
  }

  .pg-pv-status b {
    font-family: var(--font-handjet), var(--font-ark-pixel), monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pg-pv-signal {
    display: inline-flex;
    align-items: flex-end;
    gap: 1px;
    height: 0.45rem;
  }

  .pg-pv-signal i {
    width: 1px;
    background: var(--pg-ink);
  }

  .pg-pv-signal i:nth-child(1) { height: 0.14rem; }
  .pg-pv-signal i:nth-child(2) { height: 0.24rem; }
  .pg-pv-signal i:nth-child(3) { height: 0.34rem; }
  .pg-pv-signal i:nth-child(4) { height: 0.44rem; opacity: 0.28; }

  .pg-pv-batt {
    width: 0.7rem;
    height: 0.4rem;
    box-shadow: inset 0 0 0 1px var(--pg-ink);
  }

  .pg-pv-batt::before {
    content: "";
    display: block;
    width: 60%;
    height: 100%;
    background: var(--pg-green);
  }

  .pg-pv-name {
    margin: 0.45rem 0 0.12rem;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .pg-pv-headline {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 0.5rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .pg-pv-loc {
    margin: 0.18rem 0 0;
    color: var(--pg-dim);
    font-size: 0.42rem;
    letter-spacing: 0.05em;
  }

  .pg-pv-msg {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    margin: 0.38rem 0 0;
    padding-top: 0.22rem;
    border-top: 1px dotted var(--pg-dim);
  }

  .pg-pv-msg span {
    color: var(--pg-dim);
    font-size: 0.4rem;
  }

  .pg-pv-msg i {
    flex: 1;
    border-top: 1px dotted var(--pg-dim);
  }

  .pg-pv-end {
    margin: 0.42rem 0 0;
    text-align: center;
    color: var(--pg-dim);
    font-size: 0.36rem;
    letter-spacing: 0.06em;
  }
</style>
