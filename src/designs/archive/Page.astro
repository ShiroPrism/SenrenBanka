---
/**
 * archive — 图书馆卡片目录（档案柜 / 索引卡）。
 *
 * 数据：`loadDesignView` 返回当前语言视图；页面不接触文件路径、不自行判断语言。
 *
 * 结构：一只拉开的胡桃木抽屉里立着 7 张马尼拉索引卡（卡头 + 六个分区），
 * 每张卡凸出一枚类目签（签上是共享标准标签 h2 + 卡内语域的类目词 kicker）；
 * 页脚是抽屉前沿的著录签。
 * 顺序即层级：卡头 → 简介 → 链接 → 项目 → 经历 → 技能 → 联系。
 *
 * 动效：卡片自抽屉里升起（60ms 步进，共享 Reveal 的 IO 触发），图章最后落下。
 * reduced-motion / 无 IO / 无 JS 时全部内容静态可见（隐藏态只在
 * `html[data-reveal-ready]` 下生效，见 docs/rules/visual-language.md 的 Reveal 契约）。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import { getSectionLabels } from '../../i18n/sections';
import { messages as designMessages } from './messages';
import './style.css';

const view = await loadDesignView('archive', Astro.url.pathname);
const { profile, locale, contextMenu } = view;
const t = designMessages[locale.code];
const sections = getSectionLabels(view.locale.code);
const showKicker = (kicker: string, label: string) => kicker.toUpperCase() !== label.toUpperCase();

const pad = (index: number) => String(index + 1).padStart(2, '0');
const shortUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/^mailto:/, '');
const callNo = `SB · 03 · ${String(profile.links.length).padStart(2, '0')}`;
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {locale.code !== 'zh-TW' && <Font cssVariable="--font-gowun-batang" />}
    {/* 三个声部各一面：卡头衬线 / 记录打字机 / 中文仿宋尾链（不 preload，swap 足够） */}
    <Font cssVariable="--font-sorts-mill-goudy" />
    <Font cssVariable="--font-courier-prime" />
    {locale.code !== 'zh-TW' && <Font cssVariable="--font-zhuque" />}
    <Reveal />

    {locale.code === 'zh-TW' && (
      <>
        <Font cssVariable="--font-noto-serif-tc" />
      </>
    )}
  </head>
  <body class="ar">
    <main class="ar-desk" aria-label={`${profile.name} · ${t.archiveTag}`}>
      <div class="ar-drawer">
        <div class="ar-cavity">
          <div class="ar-stack">
            {/* 01 · 卡头：姓名 / 副标题 / 所在地 / 已归档图章 */}
            <div class="ar-card ar-card-head" data-reveal style="--i:0">
              <div class="ar-tab" aria-hidden="true">
                <span class="ar-tab-no">01</span>
                <span class="ar-tab-title">{t.headTab}</span>
              </div>
              <header class="ar-head">
                <p class="ar-brand">
                  <span class="ar-brand-mark">SENRENBANKA</span>
                  <span class="ar-dim"> · {t.archiveTag}</span>
                </p>
                <h1 class="ar-name">{profile.name}</h1>
                <p class="ar-headline">{profile.headline}</p>
                {profile.location && (
                  <p class="ar-loc">
                    <span class="ar-field">{t.locationLabel}</span>
                    {profile.location}
                  </p>
                )}
                <span class="ar-pencil" aria-hidden="true">
                  3-B
                </span>
              </header>
              <div class="ar-head-foot">
                <p class="ar-callno" aria-hidden="true">
                  {callNo}
                </p>
                <div class="ar-stamp" aria-hidden="true">
                  {t.stamp}
                </div>
              </div>
            </div>

            {/* 02 · 简介（bio） */}
            <section
              class="ar-card"
              data-section="profile"
              data-reveal
              aria-labelledby="ar-notes-title"
              style="--i:1"
            >
              <div class="ar-tab">
                <span class="ar-tab-no" aria-hidden="true">
                  02
                </span>
                {showKicker(t.memoTitle, sections.profile.label) && (
                  <span class="ar-tab-kicker" aria-hidden="true">
                    {t.memoTitle}
                  </span>
                )}
                <h2 class="ar-tab-title" id="ar-notes-title">
                  {sections.profile.label}
                </h2>
              </div>
              <p class="ar-bio">{profile.bio}</p>
            </section>

            {/* 03 · 链接（links）：编号 + 标签 + 点引导 + URL */}
            <section
              class="ar-card"
              data-section="links"
              data-reveal
              aria-labelledby="ar-index-title"
              style="--i:2"
            >
              <div class="ar-tab">
                <span class="ar-tab-no" aria-hidden="true">
                  03
                </span>
                {showKicker(t.itemsTitle, sections.links.label) && (
                  <span class="ar-tab-kicker" aria-hidden="true">
                    {t.itemsTitle}
                  </span>
                )}
                <h2 class="ar-tab-title" id="ar-index-title">
                  {sections.links.label}
                </h2>
              </div>
              <ul class="ar-entries">
                {profile.links.map((link, index) => (
                  <li class="ar-entry">
                    <span class="ar-entry-no" aria-hidden="true">
                      {pad(index)}
                    </span>
                    <a class="ar-link" href={link.url}>
                      {link.label}
                    </a>
                    <span class="ar-dots" aria-hidden="true"></span>
                    <span class="ar-url" aria-hidden="true">
                      {shortUrl(link.url)}
                    </span>
                  </li>
                ))}
              </ul>
            </section>

            {/* 04 · 项目（projects） */}
            {profile.projects && profile.projects.length > 0 && (
              <section
                class="ar-card"
                data-section="projects"
                data-reveal
                aria-labelledby="ar-catalog-title"
                style="--i:3"
              >
                <div class="ar-tab">
                  <span class="ar-tab-no" aria-hidden="true">
                    04
                  </span>
                  {showKicker(t.ordersTitle, sections.projects.label) && (
                    <span class="ar-tab-kicker" aria-hidden="true">
                      {t.ordersTitle}
                    </span>
                  )}
                  <h2 class="ar-tab-title" id="ar-catalog-title">
                    {sections.projects.label}
                  </h2>
                </div>
                <ol class="ar-projects">
                  {profile.projects.map((project, index) => (
                    <li class="ar-project">
                      <p class="ar-project-title">
                        <span class="ar-entry-no" aria-hidden="true">
                          {pad(index)}
                        </span>{' '}
                        {project.url ? (
                          <a class="ar-link" href={project.url}>
                            {project.title}
                          </a>
                        ) : (
                          <span>{project.title}</span>
                        )}
                        {project.url && (
                          <span class="ar-url" aria-hidden="true">
                            {' '}
                            → {shortUrl(project.url)}
                          </span>
                        )}
                      </p>
                      {project.description && <p class="ar-note">{project.description}</p>}
                      {project.tags && project.tags.length > 0 && (
                        <p class="ar-tags">
                          <span class="ar-tags-label">{t.tagsLabel}</span>{' '}
                          {project.tags.join(' · ')}
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {/* 05 · 经历（experience） */}
            {profile.experience && profile.experience.length > 0 && (
              <section
                class="ar-card"
                data-section="experience"
                data-reveal
                aria-labelledby="ar-record-title"
                style="--i:4"
              >
                <div class="ar-tab">
                  <span class="ar-tab-no" aria-hidden="true">
                    05
                  </span>
                  {showKicker(t.logTitle, sections.experience.label) && (
                    <span class="ar-tab-kicker" aria-hidden="true">
                      {t.logTitle}
                    </span>
                  )}
                  <h2 class="ar-tab-title" id="ar-record-title">
                    {sections.experience.label}
                  </h2>
                </div>
                <ul class="ar-logs">
                  {profile.experience.map((item) => (
                    <li class="ar-log">
                      <p class="ar-log-head">
                        <span class="ar-period">{item.period ?? '----'}</span>{' '}
                        <span class="ar-org">{item.org}</span>
                        {item.role ? <span class="ar-role"> · {item.role}</span> : null}
                      </p>
                      {item.description && <p class="ar-note">{item.description}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {/* 06 · 技能（skills） */}
            {profile.skills && profile.skills.length > 0 && (
              <section
                class="ar-card"
                data-section="skills"
                data-reveal
                aria-labelledby="ar-subjects-title"
                style="--i:5"
              >
                <div class="ar-tab">
                  <span class="ar-tab-no" aria-hidden="true">
                    06
                  </span>
                  {showKicker(t.skillsTitle, sections.skills.label) && (
                    <span class="ar-tab-kicker" aria-hidden="true">
                      {t.skillsTitle}
                    </span>
                  )}
                  <h2 class="ar-tab-title" id="ar-subjects-title">
                    {sections.skills.label}
                  </h2>
                </div>
                <p class="ar-skills">{profile.skills.join(' · ')}</p>
              </section>
            )}

            {/* 07 · 联系（contact + 合计 links.length） */}
            <section
              class="ar-card"
              data-section="contact"
              data-reveal
              aria-labelledby="ar-circulation-title"
              style="--i:6"
            >
              <div class="ar-tab">
                <span class="ar-tab-no" aria-hidden="true">
                  07
                </span>
                {showKicker(t.contactTitle, sections.contact.label) && (
                  <span class="ar-tab-kicker" aria-hidden="true">
                    {t.contactTitle}
                  </span>
                )}
                <h2 class="ar-tab-title" id="ar-circulation-title">
                  {sections.contact.label}
                </h2>
              </div>
              <p class="ar-total">
                <span class="ar-total-label">{t.totalLabel}</span>
                <span class="ar-total-num">{String(profile.links.length).padStart(2, '0')}</span>
                <span class="ar-total-unit">{t.totalUnit}</span>
              </p>
              {profile.contact?.email ? (
                <p class="ar-contact">
                  <span class="ar-field">{t.contactLabel}</span>
                  <a class="ar-link ar-mailto" href={`mailto:${profile.contact.email}`}>
                    {profile.contact.email}
                  </a>
                </p>
              ) : (
                <p class="ar-contact ar-dim">{t.noMail}</p>
              )}
              {profile.contact?.note && <p class="ar-note">{profile.contact.note}</p>}
            </section>

            {/* 页脚 · 抽屉前沿的著录签（致谢 + DRAWER 03 + 样例声明） */}
            <footer
              class="ar-card ar-foot"
              data-reveal
              aria-labelledby="ar-colophon-title"
              style="--i:7"
            >
              <h2 class="ar-foot-title" id="ar-colophon-title">
                {t.colophonTitle}
              </h2>
              <p class="ar-due" aria-hidden="true">
                <span>{t.dueLabel}</span>
                <span class="ar-due-rule"></span>
              </p>
              <p class="ar-thanks">{t.footerThanks}</p>
              <p class="ar-drawer-line">{t.drawerLine}</p>
              {view.locale.notice && <p class="ar-sample">{view.locale.notice}</p>}
            </footer>
          </div>
        </div>
      </div>
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
