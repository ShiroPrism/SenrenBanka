---
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { Mail, ArrowUpRight, Globe } from '@lucide/astro';
import { loadDesignView } from '../../lib/site';
import GithubMark from '../../assets/brand/github.svg';
import './style.css';

const view = await loadDesignView('fast');
const { profile, contextMenu } = view;
---
<html lang={view.site.lang}>
  <head>
    <HeadMeta {...view.head} />
    <Reveal />
  </head>
  <body class="fs">
    <div class="fs-page">
      <header class="fs-top">
        <span class="fs-wordmark">{profile.name}</span>
        <span>{profile.location ?? 'Portfolio'}</span>
      </header>

      <main>
        <section class="fs-hero">
          <p class="fs-eyebrow fs-rise" style="--rise-delay: 0ms">Portfolio</p>
          <h1 class="fs-title fs-rise" style="--rise-delay: 30ms">{profile.headline}</h1>
          <p class="fs-lead fs-rise" style="--rise-delay: 60ms">{profile.bio}</p>
          <div class="fs-actions fs-rise" style="--rise-delay: 90ms">
            {
              profile.links.map((link) => (
                <a class="fs-btn" href={link.url}>
                  {link.icon === 'github' && <GithubMark class="fs-btn-mark" aria-hidden="true" />}
                  {link.icon === 'mail' && <Mail class="fs-btn-mark" aria-hidden="true" />}
                  {link.icon !== 'github' && link.icon !== 'mail' && <Globe class="fs-btn-mark" aria-hidden="true" />}{link.label}
                </a>
              ))
            }
          </div>
        </section>

        {
          profile.projects && profile.projects.length > 0 && (
            <section class="fs-section" data-reveal>
              <h2 class="fs-h2">Projects</h2>
              <ul class="fs-cards md:grid md:grid-cols-3 gap-4">
                {profile.projects.map((project, index) => (
                  <li class="fs-card" data-reveal>
                    <p class="fs-card-num">{String(index + 1).padStart(2, '0')}</p>
                    <h3 class="fs-card-title">
                      {project.url ? <a href={project.url}>{project.title}<ArrowUpRight class="fs-card-ext" aria-hidden="true" /></a> : project.title}
                    </h3>
                    {project.description && <p class="fs-card-desc">{project.description}</p>}
                    {project.tags && <p class="fs-card-tags">{project.tags.join(' · ')}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          profile.experience && profile.experience.length > 0 && (
            <section class="fs-section" data-reveal>
              <h2 class="fs-h2">Experience</h2>
              <ul class="fs-exp">
                {profile.experience.map((item) => (
                  <li class="fs-exp-row" data-reveal>
                    <div class="fs-exp-head">
                      <span class="fs-exp-org">{item.org}</span>
                      <span class="fs-exp-period">{item.period ?? ''}</span>
                    </div>
                    {item.role && <p class="fs-exp-role">{item.role}</p>}
                    {item.description && <p class="fs-exp-desc">{item.description}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          profile.skills && profile.skills.length > 0 && (
            <section class="fs-section" data-reveal>
              <h2 class="fs-h2">Skills</h2>
              <ul class="fs-chips">
                {profile.skills.map((skill) => (
                  <li class="fs-chip">{skill}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="fs-section">
          <h2 class="fs-h2">Contact</h2>
          <div class="fs-contact">
            {
              profile.contact?.email ? (
                <a class="fs-btn fs-btn-primary" href={`mailto:${profile.contact.email}`}>
                  {profile.contact.email}
                </a>
              ) : null
            }
            {profile.contact?.note && <p class="fs-contact-note">{profile.contact.note}</p>}
          </div>
        </section>
      </main>

      <footer class="fs-footer">
        <span>{profile.name} · built from a single profile</span>
      </footer>
    </div>
    {contextMenu.enabled && <ContextMenu config={contextMenu} />}
  </body>
</html>