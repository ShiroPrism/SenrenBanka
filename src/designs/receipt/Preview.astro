---
/**
 * receipt 预览碎片：票据机吐出的长票、齿孔边、虚线分栏、点引导与红章。
 * 不 import style.css；不声明 Font；仅供切换页装饰性引述。
 */
import { messages } from './messages';
import type { PreviewProps } from '../preview';
import './tokens.css';

export const fonts: import('astro:assets').CssVariable[] = [
  '--font-cutive-mono',
  '--font-ark-pixel',
  '--font-dseg7',
];

const { locale, name, headline, location, links = [] } = Astro.props as PreviewProps;
const t = messages[locale];
const rows = links.slice(0, 2);
const shortUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/^mailto:/, '');
---

<div class="rc-pv">
  <div class="rc-pv-machine" aria-hidden="true"></div>
  <div class="rc-pv-paper">
    <header class="rc-pv-head">
      <p class="rc-pv-brand">
        SENRENBANKA <span>· {t.receiptTag}</span>
      </p>
      <p class="rc-pv-name">{name}</p>
      {headline && <p class="rc-pv-headline">{headline}</p>}
      {location && (
        <p class="rc-pv-addr">
          # {t.addrLabel} {location}
        </p>
      )}
      <span class="rc-pv-stamp">{t.stamp}</span>
    </header>
    <p class="rc-pv-sec">{t.itemsTitle}</p>
    <ul class="rc-pv-items">
      {rows.map((link, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <b>{link.label}</b>
          <i></i>
          <em>{shortUrl(link.url)}</em>
        </li>
      ))}
    </ul>
    <p class="rc-pv-sec">{t.contactTitle}</p>
    <p class="rc-pv-total">
      <span>{t.totalLabel}</span>
      <strong>{String(links.length).padStart(2, '0')}</strong>
      <span>{t.totalUnit}</span>
    </p>
    <p class="rc-pv-thanks">{t.footerThanks}</p>
    <div class="rc-pv-barcode" aria-hidden="true"></div>
  </div>
</div>

<style>
  .rc-pv {
    position: relative;
    display: grid;
    place-items: start center;
    min-height: 9rem;
    padding: 0.85rem 1rem 0.55rem;
    overflow: hidden;
    background: radial-gradient(
      120% 90% at 50% -10%,
      #36312a,
      var(--rc-back) 62%,
      var(--rc-back-deep)
    );
    color: var(--rc-ink);
    font-family:
      var(--font-cutive-mono), var(--font-galmuri11), var(--font-ark-pixel), 'Songti SC', 'SimSun',
      'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', monospace;
    font-size: 0.5625rem;
    line-height: 1.55;
  }

  .rc-pv-machine {
    position: absolute;
    top: 0.35rem;
    left: 50%;
    width: 72%;
    height: 0.45rem;
    transform: translateX(-50%);
    border-radius: 0 0 3px 3px;
    background: linear-gradient(180deg, #4a443b, #2a2723);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.55);
  }

  .rc-pv-paper {
    position: relative;
    width: min(17rem, 92%);
    margin-top: 0.35rem;
    padding: 0.7rem 0.75rem 0.8rem;
    background: linear-gradient(180deg, var(--rc-paper), var(--rc-paper-2));
    clip-path: polygon(
      0 0.16rem,
      4% 0,
      8% 0.16rem,
      12% 0,
      16% 0.16rem,
      20% 0,
      24% 0.16rem,
      28% 0,
      32% 0.16rem,
      36% 0,
      40% 0.16rem,
      44% 0,
      48% 0.16rem,
      52% 0,
      56% 0.16rem,
      60% 0,
      64% 0.16rem,
      68% 0,
      72% 0.16rem,
      76% 0,
      80% 0.16rem,
      84% 0,
      88% 0.16rem,
      92% 0,
      96% 0.16rem,
      100% 0,
      100% calc(100% - 0.16rem),
      96% 100%,
      92% calc(100% - 0.16rem),
      88% 100%,
      84% calc(100% - 0.16rem),
      80% 100%,
      76% calc(100% - 0.16rem),
      72% 100%,
      68% calc(100% - 0.16rem),
      64% 100%,
      60% calc(100% - 0.16rem),
      56% 100%,
      52% calc(100% - 0.16rem),
      48% 100%,
      44% calc(100% - 0.16rem),
      40% 100%,
      36% calc(100% - 0.16rem),
      32% 100%,
      28% calc(100% - 0.16rem),
      24% 100%,
      20% calc(100% - 0.16rem),
      16% 100%,
      12% calc(100% - 0.16rem),
      8% 100%,
      4% calc(100% - 0.16rem),
      0 100%
    );
    filter: drop-shadow(0 7px 10px rgba(0, 0, 0, 0.48));
  }

  .rc-pv-head {
    position: relative;
    padding-right: 4.5rem;
  }

  .rc-pv-brand {
    margin: 0 0 0.2rem;
    font-size: 0.45rem;
    letter-spacing: 0.16em;
  }

  .rc-pv-brand span {
    color: var(--rc-dim);
  }

  .rc-pv-name {
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
  }

  .rc-pv-headline {
    display: -webkit-box;
    margin: 0.15rem 0 0;
    overflow: hidden;
    color: var(--rc-dim);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .rc-pv-addr {
    margin: 0.2rem 0 0;
    color: var(--rc-dim);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
  }

  .rc-pv-stamp {
    position: absolute;
    top: 0.35rem;
    right: 0;
    padding: 0.12rem 0.25rem;
    border: 1.5px solid var(--rc-red);
    box-shadow: inset 0 0 0 1px var(--rc-red);
    color: var(--rc-red);
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    transform: rotate(-8deg);
  }

  .rc-pv-sec {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    margin: 0.55rem 0 0.25rem;
    color: var(--rc-dim);
    font-size: 0.46rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .rc-pv-sec::before,
  .rc-pv-sec::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--rc-line);
  }

  .rc-pv-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rc-pv-items li {
    display: flex;
    align-items: baseline;
    gap: 0.55ch;
    margin-top: 0.12rem;
  }

  .rc-pv-items span {
    color: var(--rc-dim);
  }

  .rc-pv-items b {
    font-weight: 400;
  }

  .rc-pv-items i {
    flex: 1;
    border-top: 1.5px dotted var(--rc-faint);
  }

  .rc-pv-items em {
    max-width: 45%;
    overflow: hidden;
    color: var(--rc-dim);
    font-style: normal;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rc-pv-total {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
    margin: 0;
    color: var(--rc-dim);
    font-size: 0.46rem;
    letter-spacing: 0.14em;
  }

  .rc-pv-total strong {
    color: var(--rc-ink);
    font-family:
      var(--font-dseg7), var(--font-cutive-mono), var(--font-galmuri11), var(--font-ark-pixel),
      'Songti SC', 'SimSun', 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', monospace;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1;
  }

  .rc-pv-thanks {
    margin: 0.6rem 0 0;
    padding-top: 0.4rem;
    border-top: 1px dashed var(--rc-line);
    text-align: center;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }

  .rc-pv-barcode {
    width: 68%;
    height: 0.55rem;
    margin: 0.4rem auto 0;
    background: repeating-linear-gradient(
      90deg,
      var(--rc-ink) 0 1px,
      transparent 1px 3px,
      var(--rc-ink) 3px 5px,
      transparent 5px 7px
    );
    opacity: 0.6;
  }
</style>
