---
/**
 * receipt — 三联小票（宽屏）/ 单联（窄屏）。
 *
 * 数据：`loadDesignStrips` 返回当前视图 + 全部语言的资料条（同一数据源与构建期校验；
 * 页面不接触文件路径、不自行判断语言）。
 *
 * 布局：≥1024px 时三张票按 i18n.locales 顺序并排（窗口允许横向滚动）；
 * <1024px 只显示当前语言一联（mobile 与既有行为逐像素一致）。
 * 三个 `[data-reveal]` 集合共用共享 IntersectionObserver——横向未入画的整列保持
 * 未显现，进入视口后完成显现（口径与验证见 docs/verification/receipt.md）。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignStrips } from '../../lib/site';
import Ticket from './Ticket.astro';
import './style.css';

const { view, strips } = await loadDesignStrips('receipt', Astro.url.pathname);
const { contextMenu } = view;
---
<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {/* 不预加载：主字体两个子集 + 像素 / 段码各一；swap + 系统回退已足够（热敏纸闪一下是主题的一部分） */}
    <Font cssVariable="--font-cutive-mono" />
    <Font cssVariable="--font-ark-pixel" />
    <Font cssVariable="--font-dseg7" />
    <Reveal />
  </head>
  <body class="rc">
    <main class="rc-scene" aria-label="SenrenBanka receipt">
      {strips.map(({ locale, profile, isCurrent }) => <Ticket locale={locale} profile={profile} isCurrent={isCurrent} />)}
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
