---
/**
 * receipt — 一张当前语言的热敏小票：桌面宽票内折双栏，窄屏单栏。
 *
 * 数据：`loadDesignView` 只取当前语言（同一数据源与构建期校验；
 * 页面不接触文件路径、不自行判断语言）。
 *
 * 布局：≥1024px 为一张约 68rem 的宽票，正文在纸内折成两栏；
 * <1024px 为一张 30rem 的单栏票。共享 IntersectionObserver 驱动六个显现区块。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import Ticket from './Ticket.astro';
import './style.css';

const view = await loadDesignView('receipt', Astro.url.pathname);
const { contextMenu } = view;
---
<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {/* 不预加载：主字体两个子集 + 像素 / 段码各一；swap + 系统回退已足够（热敏纸闪一下是主题的一部分） */}
    <Font cssVariable="--font-cutive-mono" />
    <Font cssVariable="--font-ark-pixel" />
    <Font cssVariable="--font-dseg7" />
    <Reveal />
  </head>
  <body class="rc">
    <main class="rc-scene">
      <Ticket locale={view.locale} profile={view.profile} />
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
