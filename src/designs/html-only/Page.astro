---
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDesignView, localeDesignHref, localeHref } from '../../lib/site';
import { messages as designMessages } from './messages';

const view = await loadDesignView('html-only', Astro.url.pathname);
const { profile } = view;
const t = designMessages[view.locale.code];

const hasProjects = Boolean(profile.projects?.length);
const hasExperience = Boolean(profile.experience?.length);
const hasSkills = Boolean(profile.skills?.length);
const hasContact = profile.contact !== undefined;

const contents = [
  { id: 'links', label: t.links },
  ...(hasProjects ? [{ id: 'projects', label: t.projects }] : []),
  ...(hasExperience ? [{ id: 'experience', label: t.experience }] : []),
  ...(hasSkills ? [{ id: 'skills', label: t.skills }] : []),
  ...(hasContact ? [{ id: 'contact', label: t.contact }] : []),
];
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
  </head>
  <body id="top">
    <header>
      <h1>{profile.name}</h1>
      <p>{profile.headline}</p>
      {profile.location && <p>{t.location}: {profile.location}</p>}
      <p>{profile.bio}</p>
    </header>

    <nav aria-label={t.navigation}>
      <h2>{t.contents}</h2>
      <ul>
        {contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
      </ul>

      {
        view.locales.length > 1 && (
          <>
            <h2>{t.languages}</h2>
            <ul>
              {view.locales.map((entry) => (
                <li>
                  <a
                    href={
                      view.design.locales.includes(entry.code)
                        ? localeDesignHref(entry.path, view.design.id)
                        : localeDesignHref(entry.path, view.design.defaultDesignId)
                    }
                    hreflang={entry.code}
                    lang={entry.code}
                    aria-current={entry.code === view.locale.code ? 'page' : undefined}
                  >
                    {entry.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        view.site.manualSwitch && (
          <>
            <h2>{t.designs}</h2>
            <ul>
              <li><a href={localeHref(view.locale.path, 'designs/')}>{t.allDesigns}</a></li>
            </ul>
          </>
        )
      }
    </nav>

    <main>
      <section id="links" aria-labelledby="links-title">
        <h2 id="links-title">{t.links}</h2>
        <ul>
          {
            profile.links.map((link) => (
              <li><a href={link.url}>{link.label}</a></li>
            ))
          }
        </ul>
      </section>

      {
        hasProjects && (
          <section id="projects" aria-labelledby="projects-title">
            <h2 id="projects-title">{t.projects}</h2>
            <ul>
              {profile.projects!.map((project, index) => (
                <li>
                  <article aria-labelledby={`project-title-${index}`}>
                    <h3 id={`project-title-${index}`}>
                      {project.url ? <a href={project.url}>{project.title}</a> : project.title}
                    </h3>
                    {project.description && <p>{project.description}</p>}
                    {project.tags && project.tags.length > 0 && (
                      <ul aria-label={t.tags}>
                        {project.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    )}
                  </article>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        hasExperience && (
          <section id="experience" aria-labelledby="experience-title">
            <h2 id="experience-title">{t.experience}</h2>
            <ul>
              {profile.experience!.map((item) => (
                <li>
                  <article>
                    <h3>{item.org}</h3>
                    {item.role && <p>{item.role}</p>}
                    {item.period && <p>{item.period}</p>}
                    {item.description && <p>{item.description}</p>}
                  </article>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        hasSkills && (
          <section id="skills" aria-labelledby="skills-title">
            <h2 id="skills-title">{t.skills}</h2>
            <ul>
              {profile.skills!.map((skill) => <li>{skill}</li>)}
            </ul>
          </section>
        )
      }

      {
        hasContact && (
          <section id="contact" aria-labelledby="contact-title">
            <h2 id="contact-title">{t.contact}</h2>
            <address>
              {profile.contact?.note && <p>{profile.contact.note}</p>}
              {profile.contact?.email && (
                <p><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></p>
              )}
            </address>
          </section>
        )
      }
    </main>

    <footer>
      <p><a href="#top">{t.backToTop}</a></p>
    </footer>
  </body>
</html>
