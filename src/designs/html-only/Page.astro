---
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDesignView, localeDesignHref, localeHref } from '../../lib/site';
import { getSectionLabels } from '../../i18n/sections';
import { messages as designMessages } from './messages';

const view = await loadDesignView('html-only', Astro.url.pathname);
const { profile } = view;
const t = designMessages[view.locale.code];
const sections = getSectionLabels(view.locale.code);

const hasProjects = Boolean(profile.projects?.length);
const hasExperience = Boolean(profile.experience?.length);
const hasSkills = Boolean(profile.skills?.length);
const hasContact = profile.contact !== undefined;

const contents = [
  { id: 'links', label: sections.links.label },
  ...(hasProjects ? [{ id: 'projects', label: sections.projects.label }] : []),
  ...(hasExperience ? [{ id: 'experience', label: sections.experience.label }] : []),
  ...(hasSkills ? [{ id: 'skills', label: sections.skills.label }] : []),
  ...(hasContact ? [{ id: 'contact', label: sections.contact.label }] : []),
];
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
  </head>
  <body id="top">
    <header>
      <h1>{profile.name}</h1>
      <p>{profile.headline}</p>
      {profile.location && (
        <p>
          {t.location}: {profile.location}
        </p>
      )}
      <p>{profile.bio}</p>
    </header>

    <nav aria-label={t.navigation}>
      <h2>{t.contents}</h2>
      <ul>
        {contents.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>

      {view.locales.length > 1 && (
        <>
          <h2>{t.languages}</h2>
          <ul>
            {view.locales.map((entry) => (
              <li>
                <a
                  href={
                    view.design.locales.includes(entry.code)
                      ? localeDesignHref(entry.path, view.design.id)
                      : localeDesignHref(entry.path, view.design.defaultDesignId)
                  }
                  hreflang={entry.code}
                  lang={entry.code}
                  aria-current={entry.code === view.locale.code ? 'page' : undefined}
                >
                  {entry.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {view.site.manualSwitch && (
        <>
          <h2>{t.designs}</h2>
          <ul>
            <li>
              <a href={localeHref(view.locale.path, 'designs/')}>{t.allDesigns}</a>
            </li>
          </ul>
        </>
      )}
    </nav>

    <main>
      <section id="links" aria-labelledby="links-title" data-section="links">
        <h2 id="links-title">{sections.links.label}</h2>
        <ul>
          {profile.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>

      {hasProjects && (
        <section id="projects" aria-labelledby="projects-title" data-section="projects">
          <h2 id="projects-title">{sections.projects.label}</h2>
          <ul>
            {profile.projects!.map((project, index) => (
              <li>
                <article aria-labelledby={`project-title-${index}`}>
                  <h3 id={`project-title-${index}`}>
                    {project.url ? <a href={project.url}>{project.title}</a> : project.title}
                  </h3>
                  {project.description && <p>{project.description}</p>}
                  {project.tags && project.tags.length > 0 && (
                    <ul aria-label={t.tags}>
                      {project.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </article>
              </li>
            ))}
          </ul>
        </section>
      )}

      {hasExperience && (
        <section id="experience" aria-labelledby="experience-title" data-section="experience">
          <h2 id="experience-title">{sections.experience.label}</h2>
          <ul>
            {profile.experience!.map((item) => (
              <li>
                <article>
                  <h3>{item.org}</h3>
                  {item.role && <p>{item.role}</p>}
                  {item.period && <p>{item.period}</p>}
                  {item.description && <p>{item.description}</p>}
                </article>
              </li>
            ))}
          </ul>
        </section>
      )}

      {hasSkills && (
        <section id="skills" aria-labelledby="skills-title" data-section="skills">
          <h2 id="skills-title">{sections.skills.label}</h2>
          <ul>
            {profile.skills!.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </section>
      )}

      {hasContact && (
        <section id="contact" aria-labelledby="contact-title" data-section="contact">
          <h2 id="contact-title">{sections.contact.label}</h2>
          <address>
            {profile.contact?.note && <p>{profile.contact.note}</p>}
            {profile.contact?.email && (
              <p>
                <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
              </p>
            )}
          </address>
        </section>
      )}
    </main>

    <footer>
      <p>
        <a href="#top">{t.backToTop}</a>
      </p>
    </footer>
  </body>
</html>
