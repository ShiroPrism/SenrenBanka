---
/** editorial 预览碎片：暖纸、衬线大标题、不对称双栏与焦赭细线。 */
import { messages } from './messages';
import type { PreviewProps } from '../preview';
import './tokens.css';

export const fonts: import('astro:assets').CssVariable[] = ['--font-fraunces'];

const { locale, name, headline, links = [] } = Astro.props as PreviewProps;
const t = messages[locale as 'zh-CN' | 'ja' | 'en'];
const rows = links.slice(0, 2);
---

<div class="ed-pv">
  <div class="ed-pv-masthead">
    <span>{t.issueMark} · {t.personalEdition}</span>
    <span>{t.tocWorks} / {t.tocLinks}</span>
  </div>
  <div class="ed-pv-rule"><span></span></div>
  <p class="ed-pv-kicker">{t.worksLabel}</p>
  <p class="ed-pv-name">{name}</p>
  <div class="ed-pv-grid">
    <p class="ed-pv-headline">{headline}</p>
    <div class="ed-pv-links">
      {rows.map((link, index) => (
        <p><span>{String(index + 1).padStart(2, '0')}</span>{link.label}</p>
      ))}
    </div>
  </div>
  <div class="ed-pv-foot"><span>{t.worksHeading}</span><span>{t.elsewhereHeading}</span></div>
</div>

<style>
  .ed-pv {
    min-height: 9rem;
    padding: 0.7rem 0.9rem 0.8rem;
    background: var(--ed-paper);
    color: var(--ed-ink);
    font-family: Georgia, "Songti SC", "SimSun", serif;
    font-size: 0.5625rem;
    line-height: 1.5;
  }

  .ed-pv-masthead,
  .ed-pv-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ed-muted);
    font-family: system-ui, sans-serif;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ed-pv-rule {
    height: 1px;
    margin: 0.45rem 0 0.65rem;
    background: var(--ed-line);
  }

  .ed-pv-rule span {
    display: block;
    width: 26%;
    height: 2px;
    background: var(--ed-accent);
  }

  .ed-pv-kicker {
    margin: 0;
    color: var(--ed-muted);
    font-family: system-ui, sans-serif;
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ed-pv-name {
    margin: 0.1rem 0 0.5rem;
    font-family: var(--font-fraunces), Georgia, "Songti SC", serif;
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .ed-pv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 0.8rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ed-line);
  }

  .ed-pv-headline {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 0.625rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .ed-pv-links p {
    display: flex;
    gap: 0.5ch;
    margin: 0 0 0.18rem;
    color: var(--ed-muted);
  }

  .ed-pv-links span {
    color: var(--ed-accent);
    font-family: system-ui, sans-serif;
    font-size: 0.45rem;
  }

  .ed-pv-foot {
    margin-top: 0.55rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--ed-line);
    color: var(--ed-accent);
  }
</style>
