---
import { Font } from 'astro:assets';
import { ArrowUpRight, Mail, Globe } from '@lucide/astro';
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDesignView } from '../../lib/site';
import GithubMark from '../../assets/brand/github.svg';
import './style.css';

const view = await loadDesignView('editorial');
const { profile, switcher } = view;
const pad = (index: number) => String(index + 1).padStart(2, '0');
// Email 只保留一处：优先 contact.email（页脚邀请），并把它从 Elsewhere 链接列表中过滤（distill 去重）
const mailtoLink = profile.links.find((link) => link.url.startsWith('mailto:'));
const inviteEmail =
  profile.contact?.email ?? (mailtoLink ? mailtoLink.url.replace(/^mailto:/, '') : null);
const listLinks = inviteEmail ? profile.links.filter((link) => !link.url.startsWith('mailto:')) : profile.links;
---
<html lang={view.site.lang}>
  <head>
    <HeadMeta {...view.head} />
    <Font cssVariable="--font-fraunces" />
  </head>
  <body class="ed">
    <main class="ed-page">
      <header class="ed-hero">
        <div class="ed-masthead">
          <p class="ed-kicker">
            <span class="ed-kicker-mark">第 01 期</span> · 个人特刊<span class="ed-kicker-en" lang="en"> / A magazine about one person</span>
          </p>
          <nav class="ed-toc" aria-label="本期导航 / Issue navigation">
            <a href="#ed-works">精选作品</a>
            <a href="#ed-elsewhere">外部链接</a>
            {switcher.enabled && <a href={switcher.href}>切换设计 / Switch design</a>}
          </nav>
        </div>
        <h1 class="ed-name text-balance">{profile.name}</h1>
        <div class="ed-hero-grid">
          <p class="ed-headline">{profile.headline}</p>
          <div class="ed-hero-aside">
            <p class="ed-bio">{profile.bio}</p>
            {profile.location && <p class="ed-meta">{profile.location}</p>}
          </div>
        </div>
      </header>

      {
        profile.projects && profile.projects.length > 0 && (
          <section class="ed-section" aria-labelledby="ed-works">
            <div class="ed-section-head">
              <h2 id="ed-works" class="ed-section-title">Selected Works</h2>
              <p class="ed-label">精选作品</p>
            </div>
            <ol class="ed-works">
              {profile.projects.map((project, index) => (
                <li class="ed-work">
                  <span class="ed-index">{pad(index)}</span>
                  <div class="ed-work-body">
                    <h3 class="ed-work-title">
                      {project.url ? <a href={project.url}>{project.title}<ArrowUpRight class="ed-ext" aria-hidden="true" /></a> : project.title}
                    </h3>
                    {project.description && <p class="ed-work-desc">{project.description}</p>}
                    {project.tags && (
                      <p class="ed-tags">
                        {project.tags.map((tag) => (
                          <span class="ed-tag">{tag}</span>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <section class="ed-section" aria-labelledby="ed-elsewhere">
        <div class="ed-section-head">
          <h2 id="ed-elsewhere" class="ed-section-title">Elsewhere</h2>
          <p class="ed-label">外部链接</p>
        </div>
        <ul class="ed-links">
          {
            listLinks.map((link) => (
              <li>
                <a class="ed-link" href={link.url}>{link.icon === 'github' ? <GithubMark class="ed-mark" aria-hidden="true" /> : link.icon === 'mail' ? <Mail class="ed-mark" aria-hidden="true" /> : <Globe class="ed-mark" aria-hidden="true" />}{link.label}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="ed-footer">
        <div class="ed-invite">
          {profile.contact?.note && <p class="ed-invite-line">{profile.contact.note}</p>}
          {
            inviteEmail && (
              <p class="ed-invite-mail">
                <a class="ed-link" href={`mailto:${inviteEmail}`}>{inviteEmail}</a>
              </p>
            )
          }
        </div>
        <div class="ed-footer-meta">
          {switcher.enabled && <a class="ed-switch" href={switcher.href}>切换设计 / Switch design</a>}
          <p class="ed-colophon" lang="en">Designed in the shape of a magazine</p>
        </div>
      </footer>
    </main>
  </body>
</html>