---
/**
 * fairy-kei — 一只打开的复古少女玩具收藏盒。
 *
 * 数据：`loadDesignView` 取当前语言视图；页面不接触文件路径、不自行判断语言。
 * `view.head` 与 `view.contextMenu` 原样交给共享 HeadMeta / ContextMenu。
 *
 * 结构：盒盖 → 中央收藏窗与姓名牌 → 悬挂饰品（links）→ 包装说明卡（bio）
 * → 玩具抽屉（projects）→ 丝带卷轴（experience）→ 贴纸册（skills）
 * → 便签（contact）→ 收藏卡背面。移动端严格按 DOM 顺序单列。
 *
 * 交互：仅原生 `<details>` 抽屉与普通锚点，不加载主题脚本。滚动显现采用共享
 * Reveal；隐藏态只在 `html[data-reveal-ready]` 下生效，失败 / 减动态时内容始终可见。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import { messages as designMessages } from './messages';
import './style.css';

const view = await loadDesignView('fairy-kei', Astro.url.pathname);
const { profile, contextMenu } = view;
const t = designMessages[view.locale.code];

const pad = (value: number) => String(value).padStart(2, '0');
const shortUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/^mailto:/, '');
const avatarAlt = t.avatarAlt.replace('{name}', profile.name);
const hasContact = Boolean(profile.contact?.email || profile.contact?.note);
const projects = profile.projects ?? [];
const experience = profile.experience ?? [];
const skills = profile.skills ?? [];

let sectionNumber = 0;
const bioSectionNo = pad(++sectionNumber);
const projectsSectionNo = projects.length > 0 ? pad(++sectionNumber) : '';
const experienceSectionNo = experience.length > 0 ? pad(++sectionNumber) : '';
const skillsSectionNo = skills.length > 0 ? pad(++sectionNumber) : '';
// eslint-disable-next-line no-useless-assignment -- 最后一个分区编号只用于当前表达式
const contactSectionNo = hasContact ? pad(++sectionNumber) : '';
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-dongle" />}
    {/* 三个声部：Fredoka 负责糖果标签，LXGW 负责中日文手写尾链，Inter 负责阅读正文。 */}
    <Font cssVariable="--font-fredoka" />
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-lxgw" />}
    <Font cssVariable="--font-inter" />
    <Reveal />

    {view.locale.code === 'zh-TW' && (
      <>
        <Font cssVariable="--font-lxgw-tc" />
      </>
    )}
  </head>
  <body class="fk">
    <a class="fk-skip" href="#fk-main">
      {t.skipToContent}
    </a>

    <main class="fk-room" id="fk-main" tabindex="-1" aria-labelledby="fk-title">
      <article class="fk-case">
        {/* 打开的盒盖：条纹内衬、缎带、封签与铆钉全部是 CSS 几何。 */}
        <div class="fk-lid" aria-hidden="true">
          <span class="fk-lid-stitch"></span>
          <span class="fk-lid-ribbon fk-lid-ribbon--left"></span>
          <span class="fk-lid-ribbon fk-lid-ribbon--right"></span>
          <span class="fk-lid-badge">{t.caseTitle}</span>
          <span class="fk-lid-star fk-lid-star--one"></span>
          <span class="fk-lid-star fk-lid-star--two"></span>
          <span class="fk-lid-star fk-lid-star--three"></span>
          <span class="fk-lid-rivet fk-lid-rivet--tl"></span>
          <span class="fk-lid-rivet fk-lid-rivet--tr"></span>
        </div>

        <div class="fk-case-body">
          <span class="fk-hinge fk-hinge--left" aria-hidden="true"></span>
          <span class="fk-hinge fk-hinge--right" aria-hidden="true"></span>

          <header class="fk-hero">
            <div class="fk-id-copy">
              <p class="fk-kicker">
                <span class="fk-kicker-dot" aria-hidden="true"></span>
                {t.collectionLabel}
              </p>
              <h1 class="fk-name" id="fk-title">
                {profile.name}
              </h1>
              <p class="fk-headline">{profile.headline}</p>
              {profile.location && (
                <p class="fk-location">
                  <span class="fk-location-label">{t.locationLabel}</span>
                  <span>{profile.location}</span>
                </p>
              )}
            </div>

            <div class="fk-portrait">
              <span class="fk-portrait-tag" aria-hidden="true">
                {t.portraitLabel}
              </span>
              <div class="fk-window">
                <div class="fk-window-inner">
                  {profile.avatar ? (
                    <img
                      src={typeof profile.avatar === 'string' ? profile.avatar : profile.avatar.src}
                      alt={avatarAlt}
                      width="420"
                      height="320"
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <span class="fk-portrait-emblem" aria-hidden="true"></span>
                  )}
                </div>
                <span class="fk-window-glint" aria-hidden="true"></span>
              </div>
              <span class="fk-window-screw fk-window-screw--left" aria-hidden="true"></span>
              <span class="fk-window-screw fk-window-screw--right" aria-hidden="true"></span>
            </div>

            <span class="fk-catalog-tab" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
          </header>

          <nav class="fk-charms" aria-labelledby="fk-links-title">
            <div class="fk-charms-heading">
              <h2 id="fk-links-title">{t.linksTitle}</h2>
              <span class="fk-charms-count">
                <span>{pad(profile.links.length)}</span>
                {t.linkUnit}
              </span>
            </div>

            <div class="fk-chain" aria-hidden="true">
              <span class="fk-chain-bead fk-chain-bead--one"></span>
              <span class="fk-chain-bead fk-chain-bead--two"></span>
              <span class="fk-chain-bead fk-chain-bead--three"></span>
            </div>

            {profile.links.length > 0 ? (
              <ul class="fk-charm-list">
                {profile.links.map((link, index) => (
                  <li class="fk-charm">
                    <a href={link.url}>
                      <span class="fk-charm-no" aria-hidden="true">
                        {pad(index + 1)}
                      </span>
                      <span class="fk-charm-label">{link.label}</span>
                      <span class="fk-charm-url" aria-hidden="true">
                        {shortUrl(link.url)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="fk-empty">{t.noLinks}</p>
            )}
          </nav>

          <section class="fk-package" data-reveal aria-labelledby="fk-bio-title">
            <div class="fk-package-inner">
              <span class="fk-package-tape" aria-hidden="true"></span>
              <div class="fk-section-heading">
                <span class="fk-section-no" aria-hidden="true">
                  {bioSectionNo}
                </span>
                <h2 id="fk-bio-title">{t.bioTitle}</h2>
              </div>
              <p class="fk-bio">{profile.bio}</p>
              <span class="fk-package-seal" aria-hidden="true">
                {t.packageSeal}
              </span>
            </div>
          </section>

          {projects.length > 0 && (
            <section class="fk-projects" data-reveal aria-labelledby="fk-projects-title">
              <div class="fk-section-heading fk-section-heading--wide">
                <span class="fk-section-no" aria-hidden="true">
                  {projectsSectionNo}
                </span>
                <h2 id="fk-projects-title">{t.projectsTitle}</h2>
                <span class="fk-section-count" aria-hidden="true">
                  {pad(projects.length)}
                </span>
              </div>

              <ol class="fk-toy-grid">
                {projects.map((project, index) => (
                  <li class="fk-toy-box">
                    <details open>
                      <summary>
                        <span class="fk-toy-no" aria-hidden="true">
                          {pad(index + 1)}
                        </span>
                        <span class="fk-toy-heading">
                          <span class="fk-toy-title">{project.title}</span>
                          <span class="fk-toy-hint">{t.drawerHint}</span>
                        </span>
                        <span class="fk-toy-pull" aria-hidden="true">
                          <i></i>
                        </span>
                      </summary>
                      <div class="fk-toy-inside">
                        {project.description && (
                          <p class="fk-project-copy">{project.description}</p>
                        )}
                        {project.tags && project.tags.length > 0 && (
                          <ul class="fk-tags" aria-label={t.tagsLabel}>
                            {project.tags.map((tag) => (
                              <li>{tag}</li>
                            ))}
                          </ul>
                        )}
                        {project.url && (
                          <a class="fk-project-link" href={project.url}>
                            <span>{t.projectLink}</span>
                            <span class="fk-project-arrow" aria-hidden="true"></span>
                          </a>
                        )}
                      </div>
                    </details>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {experience.length > 0 && (
            <section class="fk-ribbon" data-reveal aria-labelledby="fk-experience-title">
              <div class="fk-section-heading fk-section-heading--wide">
                <span class="fk-section-no" aria-hidden="true">
                  {experienceSectionNo}
                </span>
                <h2 id="fk-experience-title">{t.experienceTitle}</h2>
                <span class="fk-section-count" aria-hidden="true">
                  {pad(experience.length)}
                </span>
              </div>

              <ol class="fk-ribbon-list">
                {experience.map((item, index) => (
                  <li class="fk-ribbon-item">
                    <span class="fk-ribbon-no" aria-hidden="true">
                      {pad(index + 1)}
                    </span>
                    <div class="fk-ribbon-card">
                      <div class="fk-experience-meta">
                        {item.period && <span class="fk-period">{item.period}</span>}
                        {item.role && <span class="fk-role">{item.role}</span>}
                      </div>
                      <h3 class="fk-org">{item.org}</h3>
                      {item.description && <p class="fk-experience-copy">{item.description}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {skills.length > 0 && (
            <section class="fk-stickers" data-reveal aria-labelledby="fk-skills-title">
              <span class="fk-sticker-holes" aria-hidden="true"></span>
              <div class="fk-section-heading fk-section-heading--wide">
                <span class="fk-section-no" aria-hidden="true">
                  {skillsSectionNo}
                </span>
                <h2 id="fk-skills-title">{t.skillsTitle}</h2>
                <span class="fk-section-count" aria-hidden="true">
                  {pad(skills.length)}
                </span>
              </div>
              <ul class="fk-sticker-list">
                {skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </section>
          )}

          {hasContact && (
            <section class="fk-contact" data-reveal aria-labelledby="fk-contact-title">
              <div class="fk-contact-note">
                <span class="fk-note-pin" aria-hidden="true">
                  <i></i>
                </span>
                <div class="fk-section-heading">
                  <span class="fk-section-no" aria-hidden="true">
                    {contactSectionNo}
                  </span>
                  <h2 id="fk-contact-title">{t.contactTitle}</h2>
                </div>
                {profile.contact?.email ? (
                  <p class="fk-contact-line">
                    <span class="fk-contact-label">{t.emailLabel}</span>
                    <a class="fk-mail" href={`mailto:${profile.contact.email}`}>
                      {profile.contact.email}
                    </a>
                  </p>
                ) : (
                  <p class="fk-contact-line fk-empty">{t.noMail}</p>
                )}
                {profile.contact?.note && <p class="fk-contact-copy">{profile.contact.note}</p>}
              </div>
            </section>
          )}

          <footer class="fk-foot" data-reveal aria-labelledby="fk-foot-title">
            <div class="fk-foot-main">
              <h2 id="fk-foot-title">{t.footerTitle}</h2>
              <p class="fk-foot-line">{t.footerLine}</p>
            </div>
            <div class="fk-foot-marks">
              <span class="fk-barcode" aria-hidden="true"></span>
              <p>
                <span>{t.brand}</span>
                {view.locale.notice && <span>{view.locale.notice}</span>}
              </p>
            </div>
          </footer>

          <span class="fk-case-latch" aria-hidden="true">
            <i></i>
          </span>
        </div>
      </article>
    </main>

    <ContextMenu config={contextMenu} />
  </body>
</html>
