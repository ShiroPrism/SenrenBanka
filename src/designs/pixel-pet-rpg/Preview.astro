---
/**
 * Pixel Pet RPG switcher preview: HUD + town map + three station tags.
 * Self-contained CSS; no page style import, no focusable content, no Font tag.
 */
import type { PreviewProps } from '../preview';
import { messages } from './messages';
import './tokens.css';

export const fonts: import('astro:assets').CssVariable[] = [
  '--font-silkscreen',
  '--font-handjet',
  '--font-ark-pixel',
];

const { locale, name, headline, location, links = [] } = Astro.props as PreviewProps;
const t = messages[locale as 'zh-CN' | 'ja' | 'en'];
const itemCount = String(links.length).padStart(2, '0');
---

<div class="pxt-pv" aria-hidden="true">
  <div class="pxt-pv-hud">
    <span class="pxt-pv-brand">{t.gameTitle}</span>
    <span class="pxt-pv-name">{name}</span>
    <span class="pxt-pv-count">{itemCount}</span>
  </div>

  <div class="pxt-pv-map">
    <span class="pxt-pv-cloud pxt-pv-cloud--one"></span>
    <span class="pxt-pv-cloud pxt-pv-cloud--two"></span>
    <span class="pxt-pv-hills"></span>
    <span class="pxt-pv-ground"></span>
    <span class="pxt-pv-path"></span>
    <span class="pxt-pv-pond"></span>

    <span class="pxt-pv-hall">
      <i></i>
    </span>
    <span class="pxt-pv-shop"></span>
    <span class="pxt-pv-flags">
      <i></i><i></i><i></i>
    </span>

    <span class="pxt-pv-node pxt-pv-node--identity">{t.identityTitle}</span>
    <span class="pxt-pv-node pxt-pv-node--links">{t.linksTitle}</span>
    <span class="pxt-pv-node pxt-pv-node--projects">{t.projectsTitle}</span>
  </div>

  <div class="pxt-pv-caption">
    <span>{headline || location || name}</span>
  </div>
</div>

<style>
  .pxt-pv,
  .pxt-pv *,
  .pxt-pv *::before,
  .pxt-pv *::after {
    box-sizing: border-box;
  }

  .pxt-pv {
    --pxt-pv-ui-stack:
      var(--font-silkscreen), var(--font-ark-pixel), "Songti SC", "SimSun", "PingFang SC",
      "Microsoft YaHei", "Hiragino Sans", "Yu Gothic UI", monospace;
    --pxt-pv-number-stack:
      var(--font-handjet), var(--font-silkscreen), var(--font-ark-pixel), "Songti SC",
      "SimSun", "PingFang SC", "Microsoft YaHei", "Hiragino Sans", "Yu Gothic UI", monospace;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    overflow: hidden;
    border: 3px solid var(--pxt-night);
    background: var(--pxt-cream);
    color: var(--pxt-night);
    font-family: var(--pxt-pv-ui-stack);
    line-height: 1.35;
  }

  .pxt-pv-hud {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 0.45rem;
    padding: 0.32rem 0.42rem;
    border-bottom: 3px solid var(--pxt-night);
    background: var(--pxt-night);
    color: var(--pxt-cream);
  }

  .pxt-pv-brand {
    color: var(--pxt-gold);
    font-size: 0.38rem;
    letter-spacing: 0.08em;
  }

  .pxt-pv-name {
    grid-column: 1;
    overflow: hidden;
    font-size: 0.7rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pxt-pv-count {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    padding-left: 0.35rem;
    border-left: 2px solid var(--pxt-muted);
    color: var(--pxt-gold);
    font-family: var(--pxt-pv-number-stack);
    font-size: 1rem;
    font-variation-settings: "wght" 700, "ELGR" 1, "ELSH" 8;
    line-height: 1;
  }

  .pxt-pv-map {
    position: relative;
    overflow: hidden;
    background: var(--pxt-sky);
  }

  .pxt-pv-cloud {
    position: absolute;
    width: 2.8rem;
    height: 0.45rem;
    background: var(--pxt-white);
    opacity: 0.82;
    box-shadow:
      0 -0.28rem 0 -0.06rem var(--pxt-white),
      0 0.28rem 0 -0.06rem var(--pxt-white);
  }

  .pxt-pv-cloud--one {
    top: 0.8rem;
    left: 0.8rem;
  }

  .pxt-pv-cloud--two {
    top: 1.45rem;
    left: 64%;
    width: 1.8rem;
    opacity: 0.62;
  }

  .pxt-pv-hills {
    position: absolute;
    right: 0;
    bottom: 32%;
    left: 0;
    height: 25%;
    background: var(--pxt-grass-dark);
    clip-path: polygon(
      0 70%, 8% 70%, 8% 42%, 20% 42%, 20% 20%, 34% 20%, 34% 42%, 47% 42%,
      47% 10%, 62% 10%, 62% 36%, 74% 36%, 74% 20%, 88% 20%, 88% 48%, 100% 48%,
      100% 100%, 0 100%
    );
    opacity: 0.76;
  }

  .pxt-pv-ground {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 48%;
    background: var(--pxt-grass);
  }

  .pxt-pv-path {
    position: absolute;
    bottom: -6%;
    left: 42%;
    width: 22%;
    height: 66%;
    background: var(--pxt-paper);
    clip-path: polygon(34% 0, 66% 0, 78% 42%, 100% 100%, 0 100%, 22% 42%);
  }

  .pxt-pv-pond {
    position: absolute;
    bottom: 0.25rem;
    left: 0.45rem;
    width: 23%;
    height: 10%;
    border: 2px solid var(--pxt-night);
    background: var(--pxt-water);
  }

  .pxt-pv-hall {
    position: absolute;
    top: 22%;
    left: 38%;
    width: 24%;
    height: 31%;
    border: 3px solid var(--pxt-night);
    background: var(--pxt-cream);
  }

  .pxt-pv-hall::before {
    content: "";
    position: absolute;
    top: -34%;
    right: -10%;
    left: -10%;
    height: 34%;
    border: 3px solid var(--pxt-night);
    background: var(--pxt-coral);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .pxt-pv-hall::after {
    content: "";
    position: absolute;
    right: 34%;
    bottom: 0;
    width: 32%;
    height: 48%;
    border: 2px solid var(--pxt-night);
    background: var(--pxt-gold);
  }

  .pxt-pv-hall i {
    position: absolute;
    top: 18%;
    left: 10%;
    width: 18%;
    height: 22%;
    background: var(--pxt-sky);
  }

  .pxt-pv-hall i::after {
    content: "";
    position: absolute;
    top: 0;
    left: calc(100% + 1.2rem);
    width: 100%;
    height: 100%;
    background: var(--pxt-sky);
  }

  .pxt-pv-shop {
    position: absolute;
    bottom: 31%;
    left: 7%;
    width: 25%;
    height: 28%;
    border: 3px solid var(--pxt-night);
    background:
      repeating-linear-gradient(
        90deg,
        var(--pxt-coral) 0 0.45rem,
        var(--pxt-cream) 0.45rem 0.9rem
      )
      top / 100% 28% no-repeat,
      var(--pxt-cream);
  }

  .pxt-pv-flags {
    position: absolute;
    top: 18%;
    right: 8%;
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    height: 34%;
  }

  .pxt-pv-flags i {
    position: relative;
    display: block;
    width: 3px;
    height: 100%;
    background: var(--pxt-night);
  }

  .pxt-pv-flags i::before {
    content: "";
    position: absolute;
    top: 0;
    left: 3px;
    width: 1rem;
    height: 0.65rem;
    border: 2px solid var(--pxt-night);
    background: var(--pxt-gold);
  }

  .pxt-pv-flags i:nth-child(2)::before {
    background: var(--pxt-coral);
  }

  .pxt-pv-flags i:nth-child(3)::before {
    background: var(--pxt-mint);
  }

  .pxt-pv-node {
    position: absolute;
    z-index: 2;
    max-width: 42%;
    padding: 0.12rem 0.24rem;
    overflow: hidden;
    border: 2px solid var(--pxt-night);
    background: var(--pxt-cream);
    box-shadow: 2px 2px 0 var(--pxt-night);
    font-size: 0.34rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pxt-pv-node--identity {
    top: 51%;
    left: 40%;
    background: var(--pxt-gold);
  }

  .pxt-pv-node--links {
    bottom: 26%;
    left: 6%;
  }

  .pxt-pv-node--projects {
    top: 52%;
    right: 4%;
  }

  .pxt-pv-caption {
    min-width: 0;
    padding: 0.26rem 0.42rem;
    border-top: 3px solid var(--pxt-night);
    background: var(--pxt-paper);
    font-size: 0.4rem;
    line-height: 1.4;
  }

  .pxt-pv-caption span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
