---
/**
 * homepage99 - a hand-maintained personal homepage from the late 1990s.
 *
 * The page is a directory, not a device: a masthead, a left section index,
 * a dense main column, and a right rail of notices and 88x31 badges.
 * The experience section is the only real table; the page skeleton is Grid.
 *
 * Motion is deliberately minimal: no Reveal, no entrance, no blinking.
 * The Under Construction stripe is the sole infinite animation and stops
 * under prefers-reduced-motion.
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDesignView } from '../../lib/site';
import { getSectionLabels } from '../../i18n/sections';
import { messages as designMessages } from './messages';
import './style.css';

const view = await loadDesignView('homepage99', Astro.url.pathname);
const t = designMessages[view.locale.code];
const sections = getSectionLabels(view.locale.code);
const { profile, contextMenu } = view;

const hasProjects = Boolean(profile.projects?.length);
const hasExperience = Boolean(profile.experience?.length);
const hasSkills = Boolean(profile.skills?.length);
const hasContact = profile.contact !== undefined;

const contents = [
  { id: 'h99-links', label: sections.links.label },
  ...(hasProjects ? [{ id: 'h99-projects', label: sections.projects.label }] : []),
  ...(hasExperience ? [{ id: 'h99-experience', label: sections.experience.label }] : []),
  ...(hasSkills ? [{ id: 'h99-skills', label: sections.skills.label }] : []),
  ...(hasContact ? [{ id: 'h99-contact', label: sections.contact.label }] : []),
];

const pad = (index: number) => String(index + 1).padStart(2, '0');
const avatarAlt = t.avatarAlt.replace('{name}', profile.name);
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-gothic-a1" />}

    {view.locale.code === 'zh-TW' && (
      <>
        <Font cssVariable="--font-noto-sans-tc" />
      </>
    )}
  </head>
  <body id="top" class="h99">
    <a class="h99-skip" href="#h99-main">
      {t.skipLink}
    </a>

    <div class="h99-page">
      <header class="h99-masthead">
        <div class="h99-topbar">
          <span class="h99-brand">{t.brand}</span>
          <span class="h99-topbar-mark" aria-hidden="true">
            //
          </span>
          <span class="h99-topbar-meta">{t.volume}</span>
          <span class="h99-topbar-status">{t.statusLine}</span>
        </div>

        <div class="h99-intro">
          <div class="h99-intro-copy">
            <p class="h99-kicker">{t.homepageLabel}</p>
            <h1 class="h99-name">{profile.name}</h1>
            <p class="h99-headline">{profile.headline}</p>
            <p class="h99-bio">{profile.bio}</p>
            {profile.location && (
              <p class="h99-location">
                <span class="h99-field-label">{t.locationLabel}</span>
                <span>{profile.location}</span>
              </p>
            )}
          </div>
          {profile.avatar && (
            <img
              class="h99-avatar"
              src={typeof profile.avatar === 'string' ? profile.avatar : profile.avatar.src}
              alt={avatarAlt}
              width="128"
              height="128"
              loading="eager"
            />
          )}
        </div>

        <div class="h99-masthead-foot">
          <span>{t.statusLine}</span>
          <span class="h99-foot-rule" aria-hidden="true">
            ////////////////
          </span>
          <span>{t.volume}</span>
        </div>
      </header>

      <div class="h99-layout">
        <nav class="h99-directory" aria-label={t.navigation}>
          <div class="h99-directory-head">
            <h2>{t.contentsTitle}</h2>
          </div>
          <ul class="h99-toc">
            {contents.map((item, index) => (
              <li>
                <span class="h99-toc-no" aria-hidden="true">
                  {pad(index)}
                </span>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ul>

          <h2 class="h99-directory-subtitle">{t.elsewhere}</h2>
          <ul class="h99-navlinks">
            {profile.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>

          {hasContact && (
            <div class="h99-contact-hint">
              <p>{t.contactHint}</p>
              {profile.contact?.email && (
                <a href={`mailto:${profile.contact.email}`}>{t.writeToMe}</a>
              )}
            </div>
          )}
        </nav>

        <main id="h99-main" class="h99-main">
          <section
            class="h99-section"
            id="h99-links"
            aria-labelledby="h99-links-title"
            data-section="links"
          >
            <div class="h99-section-head">
              <h2 id="h99-links-title">{sections.links.label}</h2>
              <span class="h99-section-mark" aria-hidden="true">
                {t.linksMark}
              </span>
            </div>
            <ul class="h99-link-list">
              {profile.links.map((link, index) => (
                <li class="h99-link-row">
                  <span class="h99-link-no" aria-hidden="true">
                    {pad(index)}
                  </span>
                  <span class="h99-link-copy">
                    <a class="h99-link-label" href={link.url}>
                      {link.label}
                    </a>
                    <span class="h99-link-url" aria-hidden="true">
                      {link.url}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          {hasProjects && (
            <section
              class="h99-section"
              id="h99-projects"
              aria-labelledby="h99-projects-title"
              data-section="projects"
            >
              <div class="h99-section-head">
                <h2 id="h99-projects-title">{sections.projects.label}</h2>
                <span class="h99-section-mark" aria-hidden="true">
                  {t.projectsMark}
                </span>
              </div>
              <ol class="h99-projects">
                {profile.projects!.map((project, index) => (
                  <li class="h99-project">
                    <span class="h99-project-no" aria-hidden="true">
                      {pad(index)}
                    </span>
                    <div class="h99-project-copy">
                      <h3 class="h99-project-title">
                        {project.url ? <a href={project.url}>{project.title}</a> : project.title}
                      </h3>
                      {project.url && (
                        <span class="h99-project-url" aria-hidden="true">
                          {project.url}
                        </span>
                      )}
                      {project.description && <p class="h99-project-desc">{project.description}</p>}
                      {project.tags && project.tags.length > 0 && (
                        <p class="h99-project-tags">
                          <span class="h99-field-label">{t.tagsLabel}</span>{' '}
                          {project.tags.map((tag) => `[${tag}]`).join(' ')}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {hasExperience && (
            <section
              class="h99-section"
              id="h99-experience"
              aria-labelledby="h99-experience-title"
              data-section="experience"
            >
              <div class="h99-section-head">
                <h2 id="h99-experience-title">{sections.experience.label}</h2>
                <span class="h99-section-mark" aria-hidden="true">
                  {t.experienceMark}
                </span>
              </div>
              <div class="h99-table-wrap">
                <table class="h99-exp">
                  <caption>{t.experienceCaption}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{t.org}</th>
                      <th scope="col">{t.role}</th>
                      <th scope="col">{t.period}</th>
                      <th scope="col">{t.description}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {profile.experience!.map((item) => (
                      <tr>
                        <th scope="row">{item.org}</th>
                        <td>
                          <span class="h99-mobile-label" aria-hidden="true">
                            {t.role}
                          </span>
                          <span class="h99-cell-value">{item.role ?? ''}</span>
                        </td>
                        <td>
                          <span class="h99-mobile-label" aria-hidden="true">
                            {t.period}
                          </span>
                          <span class="h99-cell-value">{item.period ?? ''}</span>
                        </td>
                        <td>
                          <span class="h99-mobile-label" aria-hidden="true">
                            {t.description}
                          </span>
                          <span class="h99-cell-value">{item.description ?? ''}</span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {hasSkills && (
            <section
              class="h99-section"
              id="h99-skills"
              aria-labelledby="h99-skills-title"
              data-section="skills"
            >
              <div class="h99-section-head">
                <h2 id="h99-skills-title">{sections.skills.label}</h2>
                <span class="h99-section-mark" aria-hidden="true">
                  {t.skillsMark}
                </span>
              </div>
              <ul class="h99-skills">
                {profile.skills!.map((skill) => (
                  <li>
                    <span class="h99-check" aria-hidden="true">
                      [x]
                    </span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {hasContact && (
            <section
              class="h99-section"
              id="h99-contact"
              aria-labelledby="h99-contact-title"
              data-section="contact"
            >
              <div class="h99-section-head">
                <h2 id="h99-contact-title">{sections.contact.label}</h2>
                <span class="h99-section-mark" aria-hidden="true">
                  {t.contactMark}
                </span>
              </div>
              <address class="h99-contact">
                {profile.contact?.note && <p class="h99-contact-note">{profile.contact.note}</p>}
                <p class="h99-mail-line">
                  <span class="h99-field-label">{t.emailLabel}</span>
                  {profile.contact?.email ? (
                    <a class="h99-mail" href={`mailto:${profile.contact.email}`}>
                      {profile.contact.email}
                    </a>
                  ) : (
                    <span>{t.noEmail}</span>
                  )}
                </p>
              </address>
            </section>
          )}
        </main>

        <aside class="h99-rail" aria-labelledby="h99-rail-title">
          <div class="h99-rail-head">
            <h2 id="h99-rail-title">{t.railTitle}</h2>
          </div>

          <div class="h99-construction">
            <h3 class="h99-construction-label">{t.construction}</h3>
          </div>

          <div class="h99-badge-stack" aria-hidden="true">
            {t.badges.map((badge) => (
              <span class="h99-badge">{badge}</span>
            ))}
          </div>

          <div class="h99-counter" role="group" aria-labelledby="h99-counter-title">
            <h3 id="h99-counter-title">{t.counterTitle}</h3>
            <p class="h99-counter-display" aria-hidden="true">
              {t.counterDisplay}
            </p>
            <p class="h99-counter-offline">{t.counterOffline}</p>
            <p class="h99-counter-note">{t.counterNote}</p>
          </div>
        </aside>
      </div>

      <footer class="h99-footer">
        <p class="h99-footer-name">{profile.name}</p>
        <p>{t.footerNote}</p>
        <p class="h99-top-link">
          <a href="#top">{t.backToTop}</a>
        </p>
      </footer>
    </div>

    <ContextMenu config={contextMenu} />
  </body>
</html>
