---
/**
 * lexicon — 中日英混排辞书（Read 模式）。
 *
 * 整页是一张辞书书页：书眉（词条范围）→ 双栏词条 → 页脚终记号。
 * 版式 / token / 动效论证见 ./DESIGN.md；数据仍然只经 `loadDesignView`，
 * 语言由路径统一解析，页面不自行判断语言。
 *
 * 六个分区各有一条词条细规线（`--lx-tab-top` 只用于页边索引签的装饰排布）；
 * 唯一的动效是细规线自左生长，由共享 IntersectionObserver 触发一次。
 */
import { Font } from 'astro:assets';
import ContextMenu from '../../components/ContextMenu.astro';
import HeadMeta from '../../components/HeadMeta.astro';
import Reveal from '../../components/Reveal.astro';
import { loadDesignView } from '../../lib/site';
import { getSectionLabels } from '../../i18n/sections';
import { messages as designMessages, type LexiconMessages } from './messages';
import './style.css';

const view = await loadDesignView('lexicon', Astro.url.pathname);
const t: LexiconMessages = designMessages[view.locale.code];
const sections = getSectionLabels(view.locale.code);
const showKicker = (kicker: string, label: string) => kicker.toUpperCase() !== label.toUpperCase();
const { profile, contextMenu } = view;

// 词条编号用拉丁大写字（I II III …），与书眉的范围数一致；可选区块缺席时序号顺延。
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const entries = [
  { key: 'memo', visible: true },
  { key: 'links', visible: true },
  { key: 'projects', visible: Boolean(profile.projects && profile.projects.length > 0) },
  { key: 'experience', visible: Boolean(profile.experience && profile.experience.length > 0) },
  { key: 'skills', visible: Boolean(profile.skills && profile.skills.length > 0) },
  { key: 'contact', visible: true },
].filter((entry) => entry.visible);

const entryCount = entries.length;
const romanOf = (key: string) => {
  const index = entries.findIndex((entry) => entry.key === key);
  return index === -1 ? '' : ROMAN[index];
};
---

<html lang={view.head.lang}>
  <head>
    <HeadMeta {...view.head} />
    {/* 不预加载：辞书是"翻到即读"的页面，swap + 系统宋体回退足够（书的字不该抢在纸前面）。 */}
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-zhuque" />}
    <Font cssVariable="--font-sorts-mill-goudy" />
    {view.locale.code !== 'zh-TW' && <Font cssVariable="--font-gowun-batang" />}
    <Reveal />

    {view.locale.code === 'zh-TW' && (
      <>
        <Font cssVariable="--font-noto-serif-tc" />
      </>
    )}
  </head>
  <body class="lx">
    <main class="lx-page" aria-labelledby="lx-title">
      <header class="lx-masthead">
        <p class="lx-running">
          <span class="lx-running-brand">SENRENBANKA</span>
          <span class="lx-running-folio">
            {t.lexiconWord} · {t.rangeBefore} 1–{entryCount} {t.rangeAfter}
          </span>
        </p>
        <h1 class="lx-title" id="lx-title">
          <span class="lx-title-lemma">{profile.name}</span>
          <span class="lx-title-latin" aria-hidden="true">
            SENRENBANKA
          </span>
          <span class="lx-title-pos" aria-hidden="true">
            {t.posProper}
          </span>
        </h1>
        <p class="lx-headline">{profile.headline}</p>
        {profile.location && (
          <p class="lx-origin">
            <span class="lx-origin-label">{t.originLabel}</span> {profile.location}
          </p>
        )}
      </header>

      {/* 页边索引签：纯装饰，不承载导航（可访问名由各分区 h2 承担）。 */}
      <div class="lx-tabs" aria-hidden="true">
        {entries.map((entry, index) => (
          <span class="lx-tab" style={`--lx-tab-top: ${12 + index * 14}%`}>
            {index + 1}
          </span>
        ))}
      </div>

      <div class="lx-columns">
        <section
          class="lx-entry"
          data-section="profile"
          data-reveal
          aria-labelledby="lx-memo-title"
        >
          <span class="lx-rule" aria-hidden="true"></span>
          <div class="lx-entry-head">
            <span class="lx-num" aria-hidden="true">
              {romanOf('memo')}
            </span>
            <h2 class="lx-entry-label" id="lx-memo-title">
              <span class="lx-lemma">{sections.profile.label}</span>
            </h2>
            <span class="lx-latin" aria-hidden="true">
              {t.memoLatin}
            </span>
            {showKicker(t.memoTitle, sections.profile.label) && (
              <span class="lx-word">{t.memoTitle}</span>
            )}
            <span class="lx-pos" aria-hidden="true">
              {t.memoPos}
            </span>
          </div>
          <div class="lx-entry-body">
            <p class="lx-bio">{profile.bio}</p>
          </div>
        </section>

        <section class="lx-entry" data-section="links" data-reveal aria-labelledby="lx-links-title">
          <span class="lx-rule" aria-hidden="true"></span>
          <div class="lx-entry-head">
            <span class="lx-num" aria-hidden="true">
              {romanOf('links')}
            </span>
            <h2 class="lx-entry-label" id="lx-links-title">
              <span class="lx-lemma">{sections.links.label}</span>
            </h2>
            <span class="lx-latin" aria-hidden="true">
              {t.linksLatin}
            </span>
            {showKicker(t.linksTitle, sections.links.label) && (
              <span class="lx-word">{t.linksTitle}</span>
            )}
            <span class="lx-pos" aria-hidden="true">
              {t.linksPos}
            </span>
          </div>
          <ul class="lx-refs">
            {profile.links.map((link) => (
              <li class="lx-ref">
                <span class="lx-arrow" aria-hidden="true">
                  →
                </span>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>

        {profile.projects && profile.projects.length > 0 && (
          <section
            class="lx-entry"
            data-section="projects"
            data-reveal
            aria-labelledby="lx-projects-title"
          >
            <span class="lx-rule" aria-hidden="true"></span>
            <div class="lx-entry-head">
              <span class="lx-num" aria-hidden="true">
                {romanOf('projects')}
              </span>
              <h2 class="lx-entry-label" id="lx-projects-title">
                <span class="lx-lemma">{sections.projects.label}</span>
              </h2>
              <span class="lx-latin" aria-hidden="true">
                {t.projectsLatin}
              </span>
              {showKicker(t.projectsTitle, sections.projects.label) && (
                <span class="lx-word">{t.projectsTitle}</span>
              )}
              <span class="lx-pos" aria-hidden="true">
                {t.projectsPos}
              </span>
            </div>
            <ul class="lx-works">
              {profile.projects.map((project) => (
                <li class="lx-work">
                  <p class="lx-work-title">
                    {project.url ? <a href={project.url}>{project.title}</a> : project.title}
                  </p>
                  {project.description && <p class="lx-note">{project.description}</p>}
                  {project.tags && project.tags.length > 0 && (
                    <p class="lx-tags">{project.tags.join(' · ')}</p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {profile.experience && profile.experience.length > 0 && (
          <section
            class="lx-entry"
            data-section="experience"
            data-reveal
            aria-labelledby="lx-log-title"
          >
            <span class="lx-rule" aria-hidden="true"></span>
            <div class="lx-entry-head">
              <span class="lx-num" aria-hidden="true">
                {romanOf('experience')}
              </span>
              <h2 class="lx-entry-label" id="lx-log-title">
                <span class="lx-lemma">{sections.experience.label}</span>
              </h2>
              <span class="lx-latin" aria-hidden="true">
                {t.logLatin}
              </span>
              {showKicker(t.logTitle, sections.experience.label) && (
                <span class="lx-word">{t.logTitle}</span>
              )}
              <span class="lx-pos" aria-hidden="true">
                {t.logPos}
              </span>
            </div>
            <ul class="lx-logs">
              {profile.experience.map((item) => (
                <li class="lx-log">
                  <p class="lx-log-head">
                    {item.period && <span class="lx-period">{item.period}</span>}
                    <span class="lx-org">{item.org}</span>
                    {item.role && <span class="lx-role">{item.role}</span>}
                  </p>
                  {item.description && <p class="lx-note">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {profile.skills && profile.skills.length > 0 && (
          <section
            class="lx-entry"
            data-section="skills"
            data-reveal
            aria-labelledby="lx-skills-title"
          >
            <span class="lx-rule" aria-hidden="true"></span>
            <div class="lx-entry-head">
              <span class="lx-num" aria-hidden="true">
                {romanOf('skills')}
              </span>
              <h2 class="lx-entry-label" id="lx-skills-title">
                <span class="lx-lemma">{sections.skills.label}</span>
              </h2>
              <span class="lx-latin" aria-hidden="true">
                {t.skillsLatin}
              </span>
              <span class="lx-pos" aria-hidden="true">
                {t.skillsPos}
              </span>
            </div>
            <ul class="lx-skills">
              {profile.skills.map((skill) => (
                <li class="lx-skill">{skill}</li>
              ))}
            </ul>
          </section>
        )}

        <section
          class="lx-entry"
          data-section="contact"
          data-reveal
          aria-labelledby="lx-contact-title"
        >
          <span class="lx-rule" aria-hidden="true"></span>
          <div class="lx-entry-head">
            <span class="lx-num" aria-hidden="true">
              {romanOf('contact')}
            </span>
            <h2 class="lx-entry-label" id="lx-contact-title">
              <span class="lx-lemma">{sections.contact.label}</span>
            </h2>
            <span class="lx-latin" aria-hidden="true">
              {t.contactLatin}
            </span>
            {showKicker(t.contactTitle, sections.contact.label) && (
              <span class="lx-word">{t.contactTitle}</span>
            )}
            <span class="lx-pos" aria-hidden="true">
              {t.contactPos}
            </span>
          </div>
          <div class="lx-entry-body">
            {profile.contact?.email ? (
              <p class="lx-contact">
                <span class="lx-field-label">{t.mailLabel}</span>
                <a class="lx-mail" href={`mailto:${profile.contact.email}`}>
                  {profile.contact.email}
                </a>
              </p>
            ) : (
              <p class="lx-note">{t.noMail}</p>
            )}
            {profile.contact?.note && <p class="lx-note">{profile.contact.note}</p>}
            <p class="lx-tally">
              <span class="lx-tally-label">{t.tallyLabel}</span>
              <span class="lx-tally-num">{profile.links.length}</span>
              <span class="lx-tally-unit">{t.tallyUnit}</span>
            </p>
          </div>
        </section>
      </div>

      <footer class="lx-foot">
        <p class="lx-finis">{t.finis}</p>
        {view.locale.notice && <p class="lx-sample">{view.locale.notice}</p>}
      </footer>
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
