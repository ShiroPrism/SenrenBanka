---
import InfraStyles from '../components/InfraStyles.astro';
import { localeMatchTags } from '../lib/locale-match';
import { renderRouterScript } from '../lib/router-script';
import { designsForLocale, loadSite } from '../lib/site';
import { localeDesignHref } from '../lib/site';
import { sharedMessagesFor } from '../i18n/resolve';

/**
 * 根路由 `/`（SPEC §7.3）：零外部请求的内联脚本选择设计并立即跳转。
 * 先按「手动语言偏好 → navigator.languages → 默认语言」协商 Locale（ADR 0024），
 * 再从选中 Locale 的启用池抽取设计；其他 Locale 路径始终按 URL 语言优先。
 * 无 JS → noscript 内 meta refresh 到默认语言的默认设计 + 手动链接列表。
 * SEO → noindex, follow（唯一可索引入口是各语言的默认设计页，SPEC §7.4）。
 */
const model = await loadSite();
const locale =
  model.locales.find((entry) => entry.code === model.defaultLocale) ?? model.locales[0]!;
const localeDesigns = designsForLocale(model, locale);
const m = sharedMessagesFor(locale.code);
const script = renderRouterScript({
  mode: model.mode,
  manualSwitch: model.switcherEnabled,
  defaultId: model.default.id,
  cacheHours: model.random.cacheHours,
  avoidRepeat: model.random.avoidRepeat,
  base: model.base,
  storageKey: model.storageKey,
  localeNegotiation: {
    storageKey: model.localeStorageKey,
    defaultPath: locale.path,
    entries: model.locales.map((entry) => ({
      path: entry.path,
      code: entry.code,
      matchTags: localeMatchTags(entry),
      enabled: designsForLocale(model, entry).map((design) => design.id),
    })),
  },
});
const fallbackUrl = localeDesignHref(locale.path, model.default.id);
---

<html lang={locale.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{locale.title}</title>
    <meta name="robots" content="noindex, follow" />
    <script is:inline set:html={script} />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${fallbackUrl}`} />
    </noscript>
  </head>
  <body>
    <InfraStyles />
    <main class="infra">
      <p class="infra-redirect">{m.entry.redirecting}</p>
      <noscript>
        <h1>{m.entry.noscriptHeading}</h1>
        <p>{m.entry.noscriptBody}</p>
        <ul class="infra-list">
          {localeDesigns.map((design) => (
            <li>
              <a class="infra-card" href={localeDesignHref(locale.path, design.id)}>
                <span class="name">{design.meta.displayName}</span>
              </a>
            </li>
          ))}
        </ul>
      </noscript>
    </main>
  </body>
</html>
