---
/**
 * 中性 404（SPEC §11 · ADR 0007）：noindex，GH Pages 会自动使用 dist/404.html。
 * 共享操作菜单（context.kind = 'not-found'）在此接入：本页没有"当前主题"，
 * 因此不渲染身份条、随机抽选不排除任何主题；语言切换指向各语言的入口页
 * （404 不承载主题上下文，切语言后交给入口页分配）。
 *
 * 静态托管只会送达这一份 404.html，请求路径在构建期不可知。因此本页预渲染全部
 * Locale 区块，由 `<head>` 内联脚本按「路径 → 偏好 → 浏览器 → 默认」选择展示语言；
 * 无 JS 时默认 Locale 区块保持可见（ADR 0025）。
 */
import ContextMenu from '../components/ContextMenu.astro';
import HeadMeta from '../components/HeadMeta.astro';
import InfraStyles from '../components/InfraStyles.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { sharedMessagesFor } from '../i18n/resolve';
import { buildNotFoundView, renderNotFoundLocaleScript } from '../lib/not-found';
import {
  buildActionMenuConfig,
  languageSwitcherData,
  loadSite,
  localeDesignHref,
  localeHref,
} from '../lib/site';

const model = await loadSite();
const view = buildNotFoundView(model, {
  sharedMessagesFor,
  buildActionMenuConfig,
  localeDesignHref,
  localeHref,
});
const defaultPanel = view.defaultPanel;
const contextMenu = {
  ...defaultPanel.contextMenu,
  localeVariants: view.menuLocaleVariants,
};
const script = renderNotFoundLocaleScript(view.localeScript);
const fallbackLanguage = languageSwitcherData(model, defaultPanel.locale, (entry) =>
  localeHref(entry.path),
);
---

<!doctype html>
<html lang={defaultPanel.locale.code}>
  <head>
    <HeadMeta title={defaultPanel.heading} robots="noindex, follow" />
    <style is:inline set:html={view.panelCss} />
    <script is:inline set:html={script} />
  </head>
  <body>
    <InfraStyles />
    <main class="infra">
      <h1>404</h1>
      {view.panels.map((panel) => (
        <div
          class="not-found-panel"
          data-404-panel={panel.locale.path}
          data-default={panel.locale.code === defaultPanel.locale.code ? 'true' : undefined}
          lang={panel.locale.code}
        >
          <p>{panel.body}</p>
          {/* 无 JavaScript 回退：默认区块内保留可见的语言链接组。 */}
          {panel.locale.code === defaultPanel.locale.code ? (
            <noscript>
              <LanguageSwitcher language={fallbackLanguage} />
            </noscript>
          ) : null}
          <ul class="infra-list">
            <li>
              <a class="infra-card" href={localeHref(panel.locale.path)}>
                <span class="name">{panel.backToEntry}</span>
              </a>
            </li>
            {panel.allDesignsHref ? (
              <li>
                <a class="infra-card" href={panel.allDesignsHref}>
                  <span class="name">{panel.allDesigns}</span>
                </a>
              </li>
            ) : null}
            <li>
              <a class="infra-card" href={panel.defaultDesignHref}>
                <span class="name">{panel.defaultDesignName}</span>
              </a>
            </li>
          </ul>
        </div>
      ))}
    </main>
    <ContextMenu config={contextMenu} />
  </body>
</html>
