# Normalize every text file to LF in the repository and the working tree.
# Windows checkouts must not reintroduce CRLF (e.g. src/fonts/generated.ts).
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union

# Trellis: workflow scripts are vendored tooling; specs/tasks/journals are documentation.
# Keep them out of GitHub's language breakdown without removing them from Git.
.trellis/scripts/** linguist-vendored
.trellis/tasks/** linguist-documentation
.trellis/workspace/** linguist-documentation
.trellis/spec/** linguist-documentation
.trellis/agents/** linguist-documentation
.trellis/workflow.md linguist-documentation
.trellis/config.yaml linguist-documentation
